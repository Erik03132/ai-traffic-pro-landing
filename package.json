{
  "name": "ai-traffic-pro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test server/ratelimit.test.js && node --test server/socks.test.js && node --test server/agent-core.test.js && node --test server/server.test.js && node --test src/lib/submit-lead.test.ts",
    "server": "node server/server.js",
    "dev:full": "astro dev & node server/server.js",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc",
    "worker:tail": "wrangler tail --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "astro": "^7.4.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
