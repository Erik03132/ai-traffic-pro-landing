# Конфигурация сервера приёма заявок и чат-бота.
# Скопируйте в `.env` и заполните значения. Файл НЕ коммитится.

# Порт сервера (nginx проксирует /api на этот порт)
PORT=3001

# Telegram: бот-получатель заявок.
# 1) Создайте бота через @BotFather → получите токен.
# 2) Добавьте бота в группу/канал → узнайте chat_id через @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OpenRouter — используется, когда по базе знаний нет точного ответа.
# Без него виджет отвечает только по базе знаний (это рабочий режим).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
