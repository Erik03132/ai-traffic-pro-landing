# Конфигурация сервера приёма заявок и чат-бота.
# Скопируйте в `.env` и заполните значения. Файл НЕ коммитится.

# Порт сервера (nginx проксирует /api на этот порт)
PORT=3001

# Telegram: бот-получатель заявок.
# 1) Создайте бота через @BotFather → получите токен.
# 2) Узнайте chat_id: напишите боту и посмотрите https://api.telegram.org/bot<ТОКЕН>/getUpdates
#    (либо @userinfobot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── LLM (необязательно) ────────────────────────────────────────────────────
# Виджет работает и без LLM: по типовым вопросам отвечает база знаний.
# Нужен LLM только для вопросов вне базы.
#
# Любой OpenAI-совместимый эндпоинт: /v1/chat/completions.
# Основной — локальный Ollama на VPS (быстро, без внешних ключей):
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_MODEL=qwen2.5:3b
# Запасной — внешний провайдер (если основной не ответил):
#   LLM_FALLBACK_BASE_URL=https://inference-api.nousresearch.com/v1
#   LLM_FALLBACK_MODEL=ornith/ornith-1.5-122b:free
#   LLM_FALLBACK_API_KEY=sk-nous-...
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=

# Таймаут одного вызова LLM, мс. При превышении — ответ по базе знаний/fallback.
LLM_TIMEOUT_MS=25000
