---
/**
 * Секция `[01 / НАПРАВЛЕНИЯ]` — 6 карточек услуг.
 *
 * Карточка ведёт на страницу услуги (а не в якорь формы): на главной
 * 6 услуг = 6 точек входа, и заявка должна уходить со страницы услуги.
 */
import { SERVICES } from '../data/site';
import { HOME } from '../data/site';

const { services } = HOME;
---

<section class="w-full border-b border-line bg-surface py-16 md:py-20" id="services">
  <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
    <span class="font-mono-label text-mono-label uppercase text-on-surface-variant block mb-2">
      {services.eyebrow}
    </span>
    <h2 class="section-title">{services.title}</h2>
    <p class="font-body-md text-body-md text-on-surface-variant max-w-2xl mb-10">
      {services.lead}
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {SERVICES.map((s) => (
        <a
          href={`/services/${s.slug}/`}
          class="card card-hover group flex flex-col justify-between p-6 hover:border-primary/40"
        >
          <div>
            <div class="flex items-center justify-between mb-5">
              <span class="font-mono-index text-mono-index text-on-surface-variant">
                {s.num}
              </span>
              {s.badge === 'ПОИСК + AI' ? (
                <span class="badge badge-primary">{s.badge}</span>
              ) : (
                <span class="material-symbols-outlined text-on-surface-variant group-hover:text-primary text-2xl transition-colors">
                  {s.icon}
                </span>
              )}
            </div>
            <h3 class="font-headline-sm text-[1.0625rem] leading-snug font-semibold text-on-surface mb-2 group-hover:text-primary transition-colors">
              {s.title}
            </h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant mb-6">
              {s.card}
            </p>
          </div>
          <div class="pt-4 border-t border-line flex items-center font-body-sm text-body-sm text-on-surface group-hover:text-primary font-medium">
            <span>{services.cta}</span>
            <span class="inline-block transform group-hover:translate-x-1 transition-transform duration-150 ml-1">
              →
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
