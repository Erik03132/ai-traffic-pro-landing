---
/**
 * Секция «Как мы работаем» — вместо «Кейсов».
 *
 * Публичного портфолио нет, поэтому показываем метод, а не чужие цифры.
 * Рядом — блок границ работы: он же работает как отсев нецелевых заявок.
 */
import { METHOD, BOUNDARIES } from '../data/site';
---

<section class="w-full border-b border-line bg-surface-container-lowest py-16 md:py-20" id="method">
  <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <div class="lg:col-span-5">
        <span class="font-mono-label text-mono-label uppercase text-on-surface-variant block mb-2">
          {METHOD.eyebrow}
        </span>
        <h2 class="section-title">{METHOD.title}</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">
          {METHOD.lead}
        </p>
      </div>

      <div class="lg:col-span-7 flex flex-col">
        {METHOD.items.map((item) => (
          <div class="py-6 border-b border-line first:pt-0">
            <span class="font-mono-label text-mono-label uppercase text-on-surface-variant block mb-2">
              {item.tag}
            </span>
            <h3 class="font-headline-sm text-[1.0625rem] leading-snug font-semibold text-on-surface mb-1.5">
              {item.title}
            </h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant">{item.text}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="mt-12 rounded-md border border-line bg-surface p-6 md:p-8">
      <span class="font-mono-label text-mono-label uppercase text-on-surface-variant block mb-4">
        [ЧЕГО МЫ НЕ ДЕЛАЕМ]
      </span>
      <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-2.5">
        {BOUNDARIES.map((b) => (
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-on-surface-variant text-xl mt-0.5">remove</span>
            <span class="font-body-sm text-body-sm text-on-surface-variant">{b}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
