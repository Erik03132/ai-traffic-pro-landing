---
/**
 * Секция «Как мы работаем» + границы работы.
 *
 * Дизайн перенесён из Stitch: 3 «инженерных фильтра» + баннер границ.
 * Публичного портфолио нет, поэтому показываем метод, а не чужие цифры.
 */
import { METHOD, BOUNDARIES } from '../data/site';

const filters = [
  {
    tag: '01 // ТОЧКА ВХОДА',
    title: 'Начинаем с точки входа',
    text: 'Сначала аудит потерь: если сайт конвертит мало, заливать контекст — это выброшенные деньги.',
    foot: 'Сначала точка входа, потом масштаб',
    color: 'text-terracotta-600',
    icon: 'filter_alt',
  },
  {
    tag: '02 // ЭКОНОМИКА ЛИДА',
    title: 'Считаем стоимость заявки, а не кликов',
    text: 'Каждый канал показывает CPA и ROMI. Что не считается — пересматриваем.',
    foot: 'Метрики, а не активности',
    color: 'text-sage-600',
    icon: 'query_stats',
  },
  {
    tag: '03 // ОТВЕТСТВЕННОСТЬ',
    title: 'Один партнёр на весь путь',
    text: 'От стратегии до отчёта — одна команда. Не нужно переключаться между отделами.',
    foot: 'Единая точка входа',
    color: 'text-stone-700',
    icon: 'verified_user',
  },
] as const;
---

<section class="w-full py-24 bg-stone-50" id="method">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="max-w-3xl mb-16">
      <div
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-stone-100 font-mono text-xs border border-stone-200/80 mb-4 text-terracotta-600"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-terracotta-500 animate-pulse"></span>
        <span class="tracking-wider uppercase font-semibold">{METHOD.eyebrow}</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight mb-4">
        <span class="font-sans">Как мы мыслим внутри проекта:</span>
        <br />
        <span class="accent-italic">три правила</span>
      </h2>
      <p class="text-stone-700 text-base sm:text-lg leading-relaxed font-normal max-w-2xl">
        {METHOD.lead}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
      {filters.map((f, i) => (
        <div
          class="p-8 rounded-3xl bg-white border border-stone-200 editorial-shadow flex flex-col justify-between"
        >
          <div>
            <div
              class="flex items-center justify-between pb-4 mb-4 border-b border-stone-200"
            >
              <span
                class="w-8 h-8 rounded-full border-2 border-stone-900 text-stone-900 font-mono text-xs font-semibold flex items-center justify-center shrink-0 leading-none"
              >
                {i + 1}
              </span>
              <span
                class="w-8 h-8 rounded-full border border-stone-200 bg-stone-100 flex items-center justify-center shrink-0"
                title={f.tag}
              >
                <span class="material-symbols-outlined text-[16px] text-stone-500">{f.icon}</span>
              </span>
            </div>
            <div class={`font-mono text-xs font-semibold ${f.color} mb-2 tracking-wider uppercase`}>
              {f.tag}
            </div>
            <h3 class="text-lg font-semibold text-stone-900 mb-2">{f.title}</h3>
            <p class="text-sm text-stone-700 leading-relaxed font-normal">{f.text}</p>
          </div>
          <div class="pt-6 mt-8 border-t border-sage-500/30 font-mono text-[11px] text-stone-400">
            {f.foot}
          </div>
        </div>
      ))}
    </div>

    <div class="p-8 rounded-3xl bg-white border border-stone-200 editorial-shadow">
      <div class="flex items-center justify-between gap-4 mb-6">
        <div class="font-mono text-xs font-semibold text-terracotta-600 mb-4 tracking-wider">
          [ЧЕГО МЫ НЕ ДЕЛАЕМ]
        </div>
        <span class="w-1.5 h-1.5 rounded-full bg-terracotta-500"></span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-3">
        {BOUNDARIES.map((b) => (
          <div class="flex items-start gap-3">
            <span class="material-symbols-outlined text-stone-400 text-lg mt-0.5">remove</span>
            <span class="text-sm text-stone-700 leading-relaxed">{b}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
