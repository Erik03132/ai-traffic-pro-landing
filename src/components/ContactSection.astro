---
/**
 * Секция `[05 / ОБСУЖДЕНИЕ]` — форма заявки на главной.
 *
 * Дизайн перенесён из Stitch. Сама форма — наша рабочая (`LeadForm`):
 * POST /api/lead + fallback в Telegram. Логику не трогаем.
 */
import { HOME, SITE } from '../data/site';
import LeadForm from './LeadForm.astro';

const { contact } = HOME;
---

<section class="w-full py-24 bg-white border-y border-stone-200" id="contact">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <div class="lg:col-span-5 flex flex-col justify-between">
        <div>
          <div class="font-mono text-xs font-medium text-terracotta-600 uppercase tracking-widest mb-3">
            {contact.eyebrow}
          </div>
          <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight mb-6">
            С чего начать
            <br />
            <span class="accent-italic">вашему бизнесу?</span>
          </h2>
          <p class="text-stone-700 text-base leading-relaxed mb-8 font-normal">{contact.lead}</p>

          <div class="flex flex-col gap-4 font-sans text-sm text-stone-800">
            {contact.points.map((p) => (
              <div class="flex items-center gap-3">
                <div
                  class="w-5 h-5 rounded-full bg-sage-500/10 text-sage-600 flex items-center justify-center shrink-0"
                >
                  <span class="material-symbols-outlined text-xs">check</span>
                </div>
                <span>{p}</span>
              </div>
            ))}
          </div>
        </div>

        <div
          class="mt-12 p-6 rounded-3xl bg-stone-50 border border-stone-200 flex items-center justify-between gap-4"
        >
          <div class="flex items-center gap-3">
            <div
              class="w-10 h-10 rounded-full bg-white border border-stone-200 flex items-center justify-center text-stone-900"
            >
              <span class="material-symbols-outlined text-[20px]">send</span>
            </div>
            <div>
              <div class="text-sm font-semibold text-stone-900">Прямой контакт</div>
              <div class="font-mono text-[11px] text-stone-500">ответ в течение рабочего дня</div>
            </div>
          </div>
          <a
            href={SITE.bot.link}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full bg-stone-900 text-white text-xs font-medium transition-all hover:bg-stone-800 shrink-0"
          >
            Написать
            <span class="material-symbols-outlined text-[14px]">arrow_outward</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-7">
        <LeadForm id="home-form" />
      </div>
    </div>
  </div>
</section>
