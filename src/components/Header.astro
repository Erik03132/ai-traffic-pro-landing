---
/**
 * Хедер: плавающая пилюля (дизайн Stitch), логотип, навигация, CTA.
 *
 * Якоря работают на главной (`/#services`), на остальных страницах — абсолютные,
 * чтобы не попадать в несуществующий якорь текущей страницы.
 */
import { SITE, NAV } from '../data/site';

interface Props {
  /** На главной якоря локальные, на других страницах — абсолютные. */
  isHome?: boolean;
  /**
   * На странице услуги FAQ и форма свои — ведём на локальные якоря,
   * чтобы не выбрасывать посетителя на главную.
   */
  localFaq?: boolean;
  localContact?: boolean;
}

const { isHome = false, localFaq = false, localContact = false } = Astro.props;

const href = (h: string) => {
  if (isHome || !h.startsWith('#')) return h;
  if (h === '#faq' && localFaq) return '#faq';
  if (h === '#contact' && localContact) return '#lead';
  return `/${h}`;
};
---

<header class="fixed top-5 left-0 right-0 z-50 px-4 pointer-events-none">
  <div
    class="max-w-5xl mx-auto flex items-center justify-between bg-white/90 backdrop-blur-md px-4 py-2.5 rounded-full border border-stone-200/90 editorial-shadow pointer-events-auto transition-all duration-300 hover:border-stone-300"
  >
    <a href="/" class="flex items-center gap-2.5 pl-2 group shrink-0">
      <span class="inline-flex items-center gap-2 select-none">
        <span class="text-[22px] font-extrabold tracking-[-0.03em] text-[#1e2329] leading-none">
          AI Traffic
        </span>
        <span
          class="inline-flex items-center justify-center px-3 py-0.5 rounded-tr-[16px] rounded-bl-[16px] rounded-tl-[8px] rounded-br-[8px] bg-[#d35f3b] text-white text-[15px] font-bold leading-none"
        >
          PRO
        </span>
      </span>
    </a>

    <nav
      class="hidden md:flex items-center gap-1 bg-stone-100/70 p-1 rounded-full border border-stone-200/60"
      aria-label="Основная навигация"
    >
      {NAV.map((item) => (
        <a
          href={href(item.href)}
          class="text-xs font-medium px-3.5 py-1.5 rounded-full text-stone-700 hover:text-stone-900 hover:bg-white transition-all"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <div
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-stone-100 text-stone-700 font-mono text-[11px]"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-sage-500"></span>
        <span>ONLINE</span>
      </div>

      <a
        href={href('#contact')}
        class="inline-flex items-center gap-2 px-4 py-2 bg-stone-900 hover:bg-stone-800 text-white text-xs font-medium rounded-full transition-all"
      >
        ОБСУДИТЬ ПРОЕКТ
        <span class="material-symbols-outlined text-[14px]">arrow_outward</span>
      </a>

      <button
        type="button"
        id="mobile-menu-toggle"
        class="md:hidden w-8 h-8 rounded-full border border-stone-200 flex items-center justify-center"
        aria-label="Открыть меню"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="material-symbols-outlined text-[18px]">menu</span>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden md:hidden mt-2 max-w-5xl mx-auto bg-white/95 backdrop-blur-md rounded-3xl border border-stone-200/90 editorial-shadow p-2"
  >
    <nav class="flex flex-col" aria-label="Мобильная навигация">
      {NAV.map((item) => (
        <a
          href={href(item.href)}
          class="text-sm font-medium px-4 py-3 rounded-2xl text-stone-700 hover:bg-stone-100 transition-colors"
        >
          {item.label}
        </a>
      ))}
      <a
        href={href('#contact')}
        class="mt-1 inline-flex items-center justify-center px-4 py-3 rounded-full bg-stone-900 text-white text-xs font-medium"
      >
        ОБСУДИТЬ ПРОЕКТ
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });

  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => {
      menu.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
