---
/**
 * Секция `[02 / ПРИНЦИПЫ РАБОТЫ]` — подход агентства (4 принципа).
 * Левая колонка липнет при скролле — как в макете.
 */
import { APPROACH } from '../data/site';
import { HOME } from '../data/site';

const { approach } = HOME;
---

<section
  class="w-full border-b border-line bg-surface-container-lowest py-16 md:py-20"
  id="approach"
>
  <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-start">
      <div class="lg:col-span-5 lg:sticky lg:top-24">
        <span class="font-mono-label text-mono-label uppercase text-on-surface-variant block mb-2">
          {approach.eyebrow}
        </span>
        <h2 class="section-title">{approach.title}</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">
          {approach.lead}
        </p>
      </div>

      <div class="lg:col-span-7 card overflow-hidden">
        {APPROACH.map((a) => (
          <div class="px-6 py-7 border-b border-line last:border-b-0 flex flex-col sm:flex-row items-start gap-3 sm:gap-6">
            <span class="font-mono-index text-mono-index font-semibold text-primary min-w-[56px] pt-0.5">
              {a.num} /
            </span>
            <div>
              <h3 class="font-headline-sm text-[1.0625rem] leading-snug font-semibold text-on-surface mb-1.5">
                {a.title}
              </h3>
              <p class="font-body-sm text-body-sm text-on-surface-variant">{a.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
