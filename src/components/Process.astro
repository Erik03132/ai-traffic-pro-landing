---
/**
 * Секция `[03 / ЭТАПЫ]` — процесс из 4 этапов.
 */
import { PROCESS } from '../data/site';
import { HOME } from '../data/site';

const { process } = HOME;
---

<section class="w-full border-b border-line bg-surface py-16 md:py-20" id="process">
  <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
    <span class="font-mono-label text-mono-label uppercase text-on-surface-variant block mb-2">
      {process.eyebrow}
    </span>
    <h2 class="section-title max-w-2xl">{process.title}</h2>

    <div class="relative mt-10">
      <div class="hidden lg:block absolute top-6 left-0 right-0 h-px bg-line z-0"></div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 relative z-10">
        {PROCESS.map((p) => (
          <div class="card p-6">
            <span class="w-12 h-12 rounded-md bg-surface-container-low border border-line flex items-center justify-center font-mono-index text-mono-index font-semibold text-primary mb-5">
              {p.num}
            </span>
            <h3 class="font-headline-sm text-[1.0625rem] leading-snug font-semibold text-on-surface mb-2">
              {p.title}
            </h3>
            <p class="font-body-sm text-body-sm text-on-surface-variant">
              {p.text}
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
