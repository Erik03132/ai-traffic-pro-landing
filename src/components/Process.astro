---
/**
 * Секция `[03 / ЭТАПЫ]` — процесс из 4 этапов.
 *
 * Дизайн перенесён из Stitch: карточки `rounded-3xl bg-stone-50`,
 * круглый номер `border-2 border-stone-900`, подпись этапа моно-шрифтом.
 */
import { PROCESS } from '../data/site';
import { HOME } from '../data/site';

const { process } = HOME;
---

<section class="w-full py-8 md:py-24 bg-white border-y border-stone-200" id="process">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="mb-5 md:mb-16">
      <div class="font-mono text-xs font-medium text-terracotta-600 uppercase tracking-widest mb-3">
        {process.eyebrow}
      </div>
      <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
        От первого разговора{' '}
        <span class="accent-italic">до запуска</span>
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-6">
      {PROCESS.map((p, i) => (
        <div class="p-3 sm:p-8 rounded-3xl bg-stone-50 border border-stone-200 flex flex-col justify-between editorial-shadow">
          <div>
            <div class="flex items-center gap-2.5 mb-1.5">
              <div
                class="w-6 h-6 sm:w-7 sm:h-7 rounded-full border-2 border-stone-900 text-stone-900 font-mono text-[11px] sm:text-xs font-semibold flex items-center justify-center shrink-0 leading-none"
              >
                {i + 1}
              </div>
              <h3 class="text-base font-semibold text-stone-900">{p.title}</h3>
            </div>
            <p class="text-sm text-stone-700 leading-relaxed">{p.text}</p>
          </div>
          <div class="mt-4 pt-2.5 sm:mt-8 sm:pt-4 border-t border-sage-500/30 font-mono text-[11px] text-stone-400">
            ЭТАП: {p.num}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
