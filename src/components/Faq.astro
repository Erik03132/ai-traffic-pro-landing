---
/**
 * FAQ-аккордеон. Дизайн перенесён из Stitch: карточка `rounded-2xl bg-white`,
 * кнопка-вопрос + панель ответа с `border-t`.
 *
 * Нативный <details> вместо JS-аккордеона: работает без скриптов, доступен
 * с клавиатуры, не требует гидратации. JSON-LD FAQPage собирается отдельно
 * (см. lib/seo.ts).
 */
interface Props {
  items: readonly { q: string; a: string }[];
  /** Заголовок секции. На странице услуги — «Вопросы и ответы по услуге «…»». */
  title?: string;
  eyebrow?: string;
  lead?: string;
  /** Идентификатор для FAQPage JSON-LD (если на странице свой набор). */
  id?: string;
}

const { items, title, eyebrow, lead, id = 'faq' } = Astro.props;
---

<section class="w-full py-14 md:py-24 bg-stone-50" id={id}>
  <div class="max-w-4xl mx-auto px-6 lg:px-12">
    <div class="text-center mb-10 md:mb-16">
      {eyebrow && (
        <div class="font-mono text-xs font-medium text-terracotta-600 uppercase tracking-widest mb-3">
          {eyebrow}
        </div>
      )}
      {title && (
        <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight mb-2">
          {title}
        </h2>
      )}
      {lead && <p class="accent-italic text-lg text-stone-700">{lead}</p>}
    </div>

    <div class="flex flex-col gap-3">
      {items.map((item) => (
        <details class="group bg-white rounded-2xl border border-stone-200 overflow-hidden editorial-shadow">
          <summary
            class="faq-summary w-full px-6 py-5 flex items-center justify-between gap-4 text-stone-900 font-medium text-base cursor-pointer list-none transition-colors hover:text-terracotta-600"
          >
            <span>{item.q}</span>
            <span
              class="material-symbols-outlined text-stone-400 transition-transform duration-200 group-open:rotate-180 shrink-0"
              aria-hidden="true"
            >
              expand_more
            </span>
          </summary>
          <div
            class="px-6 pb-6 text-stone-700 text-sm leading-relaxed border-t border-stone-100 pt-4"
          >
            {item.a}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
