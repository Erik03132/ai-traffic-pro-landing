---
/**
 * Форма заявки — единая для главной и страниц услуг.
 *
 * Отправка: POST /api/lead (обрабатывает сервер на VPS). Если эндпоинт недоступен
 * (сайт ещё на статике) — показываем fallback: ссылка в Telegram с уже
 * подготовленным текстом заявки. Молча «успеха» не бывает: всегда есть
 * видимый результат — либо отправлено, либо открыт чат.
 */
import { FORM_FIELDS, SERVICE_OPTIONS, ALL_SERVICES, HOME, API, SITE } from '../data/site';

interface Props {
  /** Заранее выбранная услуга (на странице услуги). */
  service?: string;
  /** Уникальный id формы — на странице может быть только одна. */
  id?: string;
}

const { service = '', id = 'lead-form' } = Astro.props;
const { contact } = HOME;

/**
 * Услуга, к которой относится страница, добавляется в список выбора первой
 * позицией. Нужно для CRM: он не входит в шестёрку на главной, поэтому его
 * нет в `SERVICE_OPTIONS`, и без этого заявка со страницы CRM ушла бы
 * как «Весь комплекс».
 */
const current = ALL_SERVICES.find((s) => s.slug === service);
const serviceOptions = current
  ? [
      { value: current.slug, label: current.title },
      ...SERVICE_OPTIONS.filter((o) => o.value !== current.slug),
    ]
  : SERVICE_OPTIONS;
---

<form
  class="space-y-6"
  id={id}
  method="post"
  action={API.lead}
  novalidate
  data-tg-bot={SITE.bot.username}
  data-lead-fallback={API.leadFallback}
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <label
        class="block font-mono text-[11px] uppercase tracking-wider text-stone-500 mb-2 font-medium"
        for={`${id}-name`}
      >
        {FORM_FIELDS.name.label} <span class="text-error">*</span>
      </label>
      <input
        class="w-full h-12 px-4 rounded-2xl border border-stone-200 bg-white text-stone-900 placeholder:text-stone-400 font-body-sm text-body-sm transition-all focus:outline-none focus:border-terracotta-500 focus:shadow-[0_0_0_3px_rgba(249,115,22,0.12)]"
        id={`${id}-name`}
        name="name"
        type="text"
        placeholder={FORM_FIELDS.name.placeholder}
        required
        autocomplete="name"
      />
      <p class="hidden text-error text-xs mt-1" data-error-for={`${id}-name`}></p>
    </div>

    <div>
      <label
        class="block font-mono text-[11px] uppercase tracking-wider text-stone-500 mb-2 font-medium"
        for={`${id}-contact`}
      >
        {FORM_FIELDS.contact.label} <span class="text-error">*</span>
      </label>
      <input
        class="w-full h-12 px-4 rounded-2xl border border-stone-200 bg-white text-stone-900 placeholder:text-stone-400 font-body-sm text-body-sm transition-all focus:outline-none focus:border-terracotta-500 focus:shadow-[0_0_0_3px_rgba(249,115,22,0.12)]"
        id={`${id}-contact`}
        name="contact"
        type="text"
        placeholder={FORM_FIELDS.contact.placeholder}
        required
        autocomplete="tel"
      />
      <p class="hidden text-error text-xs mt-1" data-error-for={`${id}-contact`}></p>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <label
        class="block font-mono text-[11px] uppercase tracking-wider text-stone-500 mb-2 font-medium"
        for={`${id}-business`}
      >
        {FORM_FIELDS.business.label}
      </label>
      <input
        class="w-full h-12 px-4 rounded-2xl border border-stone-200 bg-white text-stone-900 placeholder:text-stone-400 font-body-sm text-body-sm transition-all focus:outline-none focus:border-terracotta-500 focus:shadow-[0_0_0_3px_rgba(249,115,22,0.12)]"
        id={`${id}-business`}
        name="business"
        type="text"
        placeholder={FORM_FIELDS.business.placeholder}
      />
    </div>

    <div>
      <label
        class="block font-mono text-[11px] uppercase tracking-wider text-stone-500 mb-2 font-medium"
        for={`${id}-service`}
      >
        {FORM_FIELDS.service.label} <span class="text-error">*</span>
      </label>
      <select
        class="w-full h-12 px-4 rounded-2xl border border-stone-200 bg-white text-stone-900 font-body-sm text-body-sm transition-all focus:outline-none focus:border-terracotta-500 focus:shadow-[0_0_0_3px_rgba(249,115,22,0.12)] cursor-pointer"
        id={`${id}-service`}
        name="service"
        required
      >
        {serviceOptions.map((opt) => (
          <option value={opt.value} selected={opt.value === service}>
            {opt.label}
          </option>
        ))}
      </select>
    </div>
  </div>

  <div>
    <label
      class="block font-mono text-[11px] uppercase tracking-wider text-stone-500 mb-2 font-medium"
      for={`${id}-comment`}
    >
      {FORM_FIELDS.comment.label}
    </label>
    <textarea
      class="w-full p-4 rounded-2xl border border-stone-200 bg-white text-stone-900 placeholder:text-stone-400 font-body-sm text-body-sm transition-all focus:outline-none focus:border-terracotta-500 focus:shadow-[0_0_0_3px_rgba(249,115,22,0.12)] resize-none"
      id={`${id}-comment`}
      name="comment"
      rows="3"
      placeholder={FORM_FIELDS.comment.placeholder}
    ></textarea>
  </div>

  <div class="flex items-start gap-3 pt-1">
    <input
      class="mt-0.5 w-4 h-4 rounded border-stone-300 accent-terracotta-600 cursor-pointer shrink-0"
      id={`${id}-consent`}
      name="consent"
      type="checkbox"
      required
    />
    <label
      class="font-body-sm text-xs text-stone-600 cursor-pointer select-none leading-relaxed"
      for={`${id}-consent`}
    >
      {FORM_FIELDS.consent}
      <a class="link-underline hover:text-terracotta-600 transition-colors" href="/consent/">
        Подробнее
      </a>
    </label>
  </div>

  <p class="font-mono text-[11px] text-stone-400">{contact.consentNote}</p>

  <!-- Honeypot: боты заполняют скрытое поле, humans — нет. -->
  <div class="hidden" aria-hidden="true">
    <label for={`${id}-website`}>Не заполняйте это поле</label>
    <input id={`${id}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <button
    class="w-full py-4 rounded-full bg-stone-900 text-white font-body-sm text-body-sm font-medium transition-all hover:bg-stone-800 active:scale-[0.99] flex items-center justify-center gap-2 disabled:opacity-60 disabled:cursor-not-allowed"
    type="submit"
    data-submit
  >
    {contact.submit}
  </button>

  <div
    class="hidden p-4 rounded-2xl bg-sage-500/10 border border-sage-500/30 text-stone-900"
    data-status="success"
    role="status"
    aria-live="polite"
  >
    <div class="flex items-center gap-3">
      <span class="material-symbols-outlined text-sage-600 text-2xl">task_alt</span>
      <div>
        <h4 class="font-headline-sm text-sm font-bold">{contact.successTitle}</h4>
        <p class="font-body-sm text-xs text-stone-600 mt-0.5">{contact.successText}</p>
      </div>
    </div>
  </div>

  <div
    class="hidden p-4 rounded-2xl border border-terracotta-500/40 bg-terracotta-500/5 text-stone-900"
    data-status="error"
    role="alert"
  >
    <div class="flex items-start gap-3">
      <span class="material-symbols-outlined text-error text-2xl">error</span>
      <div>
        <h4 class="font-headline-sm text-sm font-bold">Заявка не отправлена</h4>
        <p class="font-body-sm text-xs text-stone-600 mt-0.5" data-error-text>
          {contact.errorText}
        </p>
        <a
          class="inline-flex items-center gap-1 mt-2 font-body-sm text-sm font-semibold text-terracotta-600 hover:underline"
          data-telegram-fallback
          href="#"
          target="_blank"
          rel="noopener"
        >
          Отправить в Telegram <span>→</span>
        </a>
      </div>
    </div>
  </div>
</form>

<script>
  /**
   * Отправка формы. Логика:
   * 1. Клиентская валидация (имя, контакт, согласие).
   * 2. POST /api/lead — при сетевой ошибке уходим на резервный адрес.
   * 3. Успех → баннер «Заявка отправлена».
   * 4. Ошибка/нет API → баннер ошибки + ссылка в Telegram с готовым текстом.
   */
  import { postJson } from '../lib/api-post';

  const forms = document.querySelectorAll<HTMLFormElement>('form[id]');

  for (const form of forms) {
    const id = form.id;
    const submitBtn = form.querySelector<HTMLButtonElement>('[data-submit]');
    const success = form.querySelector<HTMLElement>('[data-status="success"]');
    const errorBox = form.querySelector<HTMLElement>('[data-status="error"]');
    const errorText = form.querySelector<HTMLElement>('[data-error-text]');
    const tgFallback = form.querySelector<HTMLAnchorElement>('[data-telegram-fallback]');

    const setError = (field: string, message: string) => {
      const input = form.querySelector<HTMLElement>(`#${CSS.escape(id + '-' + field)}`);
      const hint = form.querySelector<HTMLElement>(`[data-error-for="${id}-${field}"]`);
      if (input) input.classList.add('border-error');
      if (hint) {
        hint.textContent = message;
        hint.classList.remove('hidden');
      }
    };

    const clearErrors = () => {
      form
        .querySelectorAll<HTMLElement>('.border-error')
        .forEach((el) => el.classList.remove('border-error'));
      form.querySelectorAll<HTMLElement>('[data-error-for]').forEach((el) => {
        el.textContent = '';
        el.classList.add('hidden');
      });
    };

    const telegramLink = (data: Record<string, string>) => {
      const bot = form.dataset.tgBot ?? 'ai_bureau_new_bot';
      const lines = [
        `Заявка с сайта ${window.location.host}`,
        '',
        `Имя: ${data.name}`,
        `Контакт: ${data.contact}`,
        `Услуга: ${data.service}`,
        data.business ? `Компания / сайт: ${data.business}` : '',
        data.comment ? `О проекте: ${data.comment}` : '',
      ].filter(Boolean);
      return `https://t.me/${bot}?text=${encodeURIComponent(lines.join('\n'))}`;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();
      success?.classList.add('hidden');
      errorBox?.classList.add('hidden');

      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;

      // Honeypot: молча игнорируем, но показываем «успех», чтобы бот не подбирал ввод.
      if (data.website) {
        success?.classList.remove('hidden');
        form.reset();
        return;
      }

      let valid = true;
      if (!data.name?.trim()) {
        setError('name', 'Укажите имя — так проще ответить.');
        valid = false;
      }
      if (!data.contact?.trim()) {
        setError('contact', 'Укажите телефон или Telegram для связи.');
        valid = false;
      }
      if (!form.querySelector<HTMLInputElement>(`#${CSS.escape(id + '-consent')}`)?.checked) {
        valid = false;
        errorText && (errorText.textContent = 'Нужно согласие на обработку персональных данных.');
        errorBox?.classList.remove('hidden');
      }
      if (!valid) return;

      const originalLabel = submitBtn?.textContent ?? '';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Отправка…';
      }

      try {
        // Отправка с резервом: если Worker недоступен по сети, уходим на
        // резервный адрес (Node-сервер на VPS). Повтор делается только при
        // сетевой ошибке — на 5xx повтор запрещён, иначе будет дубль заявки.
        const result = await postJson({
          url: form.action,
          fallbackUrl: form.dataset.leadFallback || undefined,
          payload: { ...data, source: window.location.pathname },
        });

        if (!result.ok) throw new Error('HTTP ' + result.status);

        form.reset();
        success?.classList.remove('hidden');
        success?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } catch (err) {
        console.error('Lead submit failed:', err);
        if (tgFallback) tgFallback.href = telegramLink(data);
        if (errorText) {
          errorText.textContent =
            'Не получилось отправить. Напишите нам в Telegram — ссылка справа внизу.';
        }
        errorBox?.classList.remove('hidden');
        errorBox?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalLabel;
        }
      }
    });
  }
</script>
