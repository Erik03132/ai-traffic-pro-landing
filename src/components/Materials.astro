---
/**
 * Секция `[05 / МАТЕРИАЛЫ]` на главной: вход в блог.
 *
 * Зачем: до 22.11.2026 единственная ссылка на статьи с главной была в подвале.
 * Замер AI-видимости (docs/seo/ai-visibility-2026-11-22.md) показал: статьи про
 * ROMI, GEO-чек-лист и AI-ответы есть, но по своим запросам не ранжируются —
 * внутренних ссылок на них почти нет. Ссылка с главной — самый тяжёлый
 * внутренний сигнал, поэтому три ключевых материала выводятся здесь.
 *
 * Состав задаётся в `HOME.materials.items`, тексты статей — в `src/data/blog`.
 */
import { ARTICLES } from '../data/blog';
import { HOME } from '../data/site';

const { eyebrow, title, lead, cta, items } = HOME.materials;

/** Статьи в порядке из данных главной; отсутствующие слаги просто пропускаются. */
const articles = items
  .map((item) => ARTICLES.find((a) => a.slug === item.slug))
  .filter((a): a is (typeof ARTICLES)[number] => Boolean(a));
---

{
  articles.length > 0 && (
    <section class="w-full py-8 md:py-24 bg-stone-50 border-t border-stone-200" id="materials">
      <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <div class="max-w-3xl mb-5 md:mb-12">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-stone-100 font-mono text-xs border border-stone-200/80 mb-4 text-terracotta-600">
            <span class="tracking-wider uppercase font-semibold">{eyebrow}</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight mb-4">
            {title}
          </h2>
          <p class="font-body-md text-body-md text-stone-700 leading-relaxed">{lead}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-6">
          {articles.map((a) => (
            <a
              href={`/blog/${a.slug}/`}
              class="group rounded-2xl border border-stone-200 bg-white p-5 sm:p-6 flex flex-col justify-between gap-4 hover:border-stone-300 transition-colors"
            >
              <div>
                <div class="flex items-center gap-3 mb-3">
                  <span class="font-mono-label text-mono-label uppercase tracking-wider text-terracotta-600">
                    {a.tag}
                  </span>
                  <span class="font-mono-index text-mono-index text-stone-400">
                    {a.readingTime} мин
                  </span>
                </div>
                <h3 class="text-lg sm:text-xl font-light text-stone-900 leading-snug mb-2 group-hover:text-terracotta-600 transition-colors">
                  {a.title}
                </h3>
                <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                  {a.seoDescription}
                </p>
              </div>
              <span class="font-mono text-[11px] uppercase tracking-wider text-terracotta-600">
                Читать →
              </span>
            </a>
          ))}
        </div>

        <div class="mt-8">
          <a
            href="/blog/"
            class="inline-flex items-center gap-2 font-body-sm text-body-sm font-semibold text-stone-900 underline decoration-stone-300 underline-offset-4 hover:text-terracotta-600 hover:decoration-terracotta-600 transition-colors"
          >
            {cta}
          </a>
        </div>
      </div>
    </section>
  )
}
