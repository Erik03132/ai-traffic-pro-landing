---
/**
 * Счётчик Яндекс.Метрики + две цели, которые считает сам браузер:
 * `phone_click` (клик по `tel:`) и `scroll_75` (дочитал до 75 % страницы).
 *
 * Цели `lead_submit` и `chat_open` отправляют форма и виджет — через
 * `reachGoal` из `src/lib/analytics.ts`.
 *
 * Без `PUBLIC_YM_COUNTER_ID` не рендерится ничего: локальная сборка и превью
 * не засоряют статистику. Номер счётчика — переменная окружения сборки,
 * в репозитории его нет (см. README, раздел «Аналитика»).
 */
import { YM_COUNTER_ID } from '../data/site';
---

{YM_COUNTER_ID && (
  <Fragment>
    <script is:inline define:vars={{ YM_COUNTER_ID }}>
      (function (m, e, t, r, i, k, a) {
        m[i] =
          m[i] ||
          function () {
            (m[i].a = m[i].a || []).push(arguments);
          };
        m[i].l = 1 * new Date();
        for (var j = 0; j < document.scripts.length; j++) {
          if (document.scripts[j].src === r) return;
        }
        ((k = e.createElement(t)),
          (a = e.getElementsByTagName(t)[0]),
          (k.async = 1),
          (k.src = r),
          a.parentNode.insertBefore(k, a));
      })(window, document, 'script', 'https://mc.yandex.ru/metrika/tag.js', 'ym');

      window.__ymCounterId = Number(YM_COUNTER_ID);
      window.ym(Number(YM_COUNTER_ID), 'init', {
        // ВАЖНО: НЕ добавлять `ssr: true`. Опция нужна SPA/SSR-рендерингу; на
        // статической сборке Astro она молча обрывает инициализацию счётчика:
        // tag.js грузится (200), но ни одного хита не уходит, ошибок в консоли
        // нет. Проверено 02.11.2026 на изолированной странице — с `ssr: true`
        // счётчик не регистрируется, без него регистрируется и шлёт хиты.
        clickmap: true,
        // Webvisor выключен осознанно: формы собирают телефоны и имена,
        // запись ввода — риск по 152-ФЗ. Включать только после юридической
        // проверки и настройки маскирования полей (ADR-004).
        webvisor: false,
        accurateTrackBounce: true,
        trackLinks: true,
      });
    </script>
    <noscript>
      <div>
        <img
          src={`https://mc.yandex.ru/watch/${YM_COUNTER_ID}`}
          style="position:absolute; left:-9999px;"
          alt=""
        />
      </div>
    </noscript>
  </Fragment>
)}

<script>
  import { reachGoal } from '../lib/analytics';

  /** Клик по телефону — событие, не навигация: считаем каждый клик. */
  document.addEventListener('click', (event) => {
    const target = event.target as Element | null;
    const link = target?.closest?.('a[href^="tel:"]');
    if (!link) return;
    reachGoal('phone_click', {
      page: window.location.pathname,
      phone: link.getAttribute('href')?.replace(/^tel:/, '') ?? '',
    });
  });

  /**
   * Дочитал до 75 % страницы.
   *
   * Считаем по реальной прокрутке: ratio = scrollY / (scrollHeight - innerHeight).
   * Страницы без прокрутки не считаются — там «дочитал» ничего не значит.
   * Цель уходит один раз за страницу.
   */
  const trackScroll75 = () => {
    let tagged = false;

    const check = () => {
      if (tagged) return;
      const doc = document.documentElement;
      const scrollable = doc.scrollHeight - window.innerHeight;
      if (scrollable < 200) return;
      if (window.scrollY / scrollable < 0.75) return;
      tagged = true;
      reachGoal('scroll_75', { page: window.location.pathname }, { once: true });
      window.removeEventListener('scroll', check);
    };

    window.addEventListener('scroll', check, { passive: true });
    check();
  };

  trackScroll75();
</script>
