---
/**
 * Hero: бейджи, H1 с курсивными акцентами, лид, CTA и панель «live pipeline».
 *
 * Дизайн перенесён из Stitch (проект 347837169574599192, экран
 * «AI-Traffic-Pro — Комплексная система роста»).
 * Тексты — из `src/data/site.ts` (единый источник истины).
 */
import { HOME } from '../data/site';

const { hero } = HOME;
---

<section class="relative w-full pb-12 sm:pb-20 lg:pb-32 px-6 lg:px-12 max-w-7xl mx-auto">
  <div class="max-w-5xl mx-auto flex flex-col items-start gap-6 sm:gap-10 lg:gap-12">
    <div class="w-full grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-10 lg:gap-12 items-center">
      <div class="lg:col-span-7 flex flex-col items-start gap-5 sm:gap-8">
        <div class="flex flex-wrap items-center gap-3">
          <div
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-stone-200 text-stone-700 font-mono text-xs editorial-shadow"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-terracotta-500 animate-pulse"></span>
            <span class="tracking-wider uppercase font-medium">{hero.badge}</span>
          </div>
          <div
            class="hidden sm:inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-stone-100 text-stone-700 font-mono text-xs border border-stone-200/70"
          >
            <span class="w-1.5 h-1.5 rounded-full bg-terracotta-500"></span>
            <span class="font-medium">ЕДИНАЯ СИСТЕМА РОСТА</span>
          </div>
        </div>

        <h1 class="text-5xl sm:text-6xl lg:text-7xl font-light text-stone-900 tracking-tight leading-[1.06]">
          {hero.h1Top}{' '}
          <br class="hidden sm:block" />
          <span class="accent-italic">{hero.h1Accent}</span>
          <br />
          {hero.h1Bottom}{' '}
          <span class="accent-italic">{hero.h1BottomAccent}</span>
        </h1>

        <p class="font-sans text-lg sm:text-xl text-stone-700 max-w-2xl leading-relaxed font-normal">
          {hero.lead}
        </p>

        <div class="flex flex-wrap items-center gap-4">
          <a href="#contact" class="btn btn-dark">
            <span>{hero.ctaPrimary}</span>
            <span class="material-symbols-outlined text-[18px]">arrow_outward</span>
          </a>
          <a href="#services" class="btn btn-light">
            <span>{hero.ctaSecondary}</span>
            <span class="material-symbols-outlined text-[18px]">north_east</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 w-full">
        <div
          class="bg-white border border-stone-200 rounded-3xl p-5 sm:p-7 flex flex-col gap-4 sm:gap-6 editorial-shadow"
        >
          <div class="flex items-center justify-between">
            <div class="inline-flex items-center gap-2 font-mono text-[11px] text-stone-700">
              <span class="w-1.5 h-1.5 rounded-full bg-sage-500"></span>
              <span>AI-TRAFFIC // LIVE PIPELINE</span>
            </div>
            <span
              class="font-mono text-[10px] uppercase px-2.5 py-1 rounded-full bg-stone-100 text-stone-700 border border-stone-200"
            >
              ACTIVE
            </span>
          </div>

          <div>
            <h2 class="text-xl sm:text-2xl font-light text-stone-900 tracking-tight leading-snug">
              Синхронизация 6 каналов в единый поток
            </h2>
            <p class="text-xs text-stone-600 leading-relaxed mt-2">
              Отслеживание конверсий и сквозная оптимизация CPA в реальном времени
            </p>
          </div>

          <div class="p-4 rounded-2xl bg-stone-50 border border-stone-200/80">
            <div class="flex items-center justify-between mb-3">
              <span class="font-mono text-[11px] text-stone-600 uppercase tracking-wider">
                ПУТЬ КЛИЕНТА // ПОТОК РОСТА
              </span>
              <span class="font-mono text-[11px] font-semibold text-terracotta-600">100% SYNC</span>
            </div>
            <div class="grid grid-cols-3 gap-2">
              {hero.funnel.map((f) => (
                <div class="p-3 rounded-xl bg-white border border-stone-200/90">
                  <div class="font-mono text-[10px] text-stone-500 uppercase mb-1.5">{f.step}</div>
                  <div class="text-xs font-semibold text-stone-900 leading-tight mb-1.5">{f.label}</div>
                  <div class="font-mono text-[10px] text-sage-600">+{f.gain}</div>
                </div>
              ))}
            </div>
          </div>

          <div class="flex flex-col gap-3">
            {hero.metrics.map((m) => (
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <span class="text-[11px] text-stone-600">{m.label}</span>
                  <span class="font-mono text-[11px] font-semibold text-stone-900">{m.value}</span>
                </div>
                <div class="h-1.5 rounded-full bg-stone-200/70 overflow-hidden">
                  <div
                    class="h-full rounded-full"
                    style={`width:${m.percent}%;background-color:${m.color}`}
                  >
                  </div>
                </div>
              </div>
            ))}
          </div>

          <div class="flex items-center justify-between pt-4 border-t border-stone-200">
            <span class="inline-flex items-center gap-1.5 font-mono text-[11px] text-stone-500">
              <span class="material-symbols-outlined text-[14px]">database</span>
              Ежедневная связка данных
            </span>
            <span class="inline-flex items-center gap-1.5 font-mono text-[11px] text-stone-500">
              <span class="material-symbols-outlined text-[14px]">schedule</span>
              Дайджест 24/7
            </span>
          </div>
        </div>
      </div>
    </div>

    <div
      class="w-full grid grid-cols-1 md:grid-cols-3 gap-3 p-5 sm:gap-6 sm:p-8 rounded-3xl bg-white border border-stone-200 editorial-shadow"
    >
      <div>
        <div class="font-mono text-[11px] uppercase tracking-widest text-terracotta-600 mb-2">
          СВЯЗАННЫЙ МАРКЕТИНГ
        </div>
        <p class="text-sm text-stone-700 leading-relaxed">
          6 направлений в одной синхронной связке
        </p>
      </div>
      <div>
        <div class="font-mono text-[11px] uppercase tracking-widest text-sage-600 mb-2">
          БЫСТРЫЕ СПРИНТЫ
        </div>
        <p class="text-sm text-stone-700 leading-relaxed">
          Спринты по 14 дней с прозрачной фиксацией CPA и ROMI
        </p>
      </div>
      <div>
        <div class="font-mono text-[11px] uppercase tracking-widest text-stone-700 mb-2">
          ТЕХНОЛОГИЯ
        </div>
        <p class="text-sm text-stone-700 leading-relaxed">
          Прямая интеграция AI-инструментов в маркетинг и поиск
        </p>
      </div>
    </div>
  </div>
</section>
