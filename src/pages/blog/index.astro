---
/**
 * Список статей блога. Данные — `src/data/blog`, тексты в разметке отсутствуют.
 */
import Base from '../../layouts/Base.astro';

import { ARTICLES } from '../../data/blog';
import { ALL_SERVICES, SITE } from '../../data/site';
import { blogLd, organizationLd } from '../../lib/seo';

const path = '/blog/';

/** Статьи по убыванию даты: свежие выше. */
const articles = [...ARTICLES].sort((a, b) => (a.date < b.date ? 1 : -1));

const ld = [
  ...organizationLd().filter((o) => o['@type'] !== 'FAQPage' && o['@type'] !== 'Service'),
  blogLd(articles),
];

const title = (slug: string) => ALL_SERVICES.find((s) => s.slug === slug)?.title ?? '';

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base
  meta={{
    title: 'Блог о продвижении: SEO, GEO, реклама, соцсети, сайты | AI-Traffic PRO',
    description:
      'Разбираем практические вопросы маркетинга: как выбрать канал, считать окупаемость, готовить сайт к ответам нейросетей, вести соцсети и навести порядок в заявках.',
    path,
  }}
  ld={ld}
>
  <!-- Хлебные крошки -->
  <nav aria-label="Хлебные крошки" class="bg-surface-container-lowest border-b border-line">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop py-4">
      <ol class="flex flex-wrap items-center gap-2 font-mono-index text-mono-index text-on-surface-variant">
        <li>
          <a href="/" class="hover:text-primary-container transition-colors">
            Главная
          </a>
        </li>
        <li aria-hidden="true" class="text-outline">
          /
        </li>
        <li class="text-on-surface" aria-current="page">
          Блог
        </li>
      </ol>
    </div>
  </nav>

  <!-- Заголовок -->
  <header class="w-full border-b border-line bg-surface-container-lowest">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop py-16 md:py-24">
      <span class="font-mono-label text-mono-label uppercase text-primary-container tracking-widest font-semibold block mb-3">
        [БЛОГ]
      </span>
      <h1 class="font-headline-xl text-headline-xl md:text-[56px] font-bold tracking-tight text-on-surface max-w-3xl mb-6">
        Разбираем маркетинг по частям
      </h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed max-w-2xl">
        Практические статьи без «10 секретов успеха»: как выбирать каналы, считать окупаемость,
        готовить сайт к ответам нейросетей и не терять заявки. Каждая статья связана с услугой, о
        которой в ней речь.
      </p>
    </div>
  </header>

  <!-- Список статей -->
  <section class="w-full bg-surface py-16 md:py-24">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {articles.map((a) => (
          <a
            href={`/blog/${a.slug}/`}
            class="group rounded-xl border border-line bg-surface-container-lowest p-8 flex flex-col hover:border-primary-container transition-colors"
          >
            <div class="flex items-center gap-3 mb-4">
              <span class="font-mono-label text-mono-label uppercase tracking-wider text-primary-container">
                {a.tag}
              </span>
              <span class="font-mono-index text-mono-index text-outline">{a.readingTime} мин</span>
            </div>

            <h2 class="font-headline-sm text-headline-sm font-bold text-on-surface mb-3 group-hover:text-primary-container transition-colors">
              {a.title}
            </h2>

            <p class="font-body-sm text-body-sm text-on-surface-variant leading-relaxed mb-5">
              {a.seoDescription}
            </p>

            <div class="mt-auto pt-5 border-t border-line flex items-center justify-between gap-3">
              <span class="font-mono-index text-mono-index text-outline">{title(a.service)}</span>
              <span class="font-mono-index text-mono-index text-outline">{fmt(a.date)}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="w-full border-t border-line bg-surface-container-low py-20 md:py-24">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
      <div class="rounded-2xl border border-line bg-surface-container-lowest p-8 md:p-14 text-center">
        <h2 class="font-headline-lg text-headline-lg font-bold tracking-tight text-on-surface mb-4">
          Не нашли свою задачу?
        </h2>
        <p class="font-body-md text-body-md text-on-surface-variant mb-8 max-w-2xl mx-auto">
          Опишите ситуацию — вернёмся с планом: что проверить первым, какие каналы имеют смысл и
          какие сроки реалистичны.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/#contact"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-lg bg-primary-container text-on-primary font-body-sm text-body-sm font-semibold hover:bg-primary transition-colors"
          >
            Оставить заявку
          </a>
          <a
            href={SITE.bot.link}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-lg border border-line bg-surface text-on-surface font-body-sm text-body-sm font-medium hover:border-primary-container hover:text-primary-container transition-colors"
          >
            Написать в Telegram
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
