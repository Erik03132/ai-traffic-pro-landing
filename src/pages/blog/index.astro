---
/**
 * Список статей блога. Данные — `src/data/blog`, тексты в разметке отсутствуют.
 */
import Base from '../../layouts/Base.astro';

import { ARTICLES } from '../../data/blog';
import { ALL_SERVICES, SITE } from '../../data/site';
import { blogLd, organizationLd } from '../../lib/seo';

const path = '/blog/';

/** Статьи по убыванию даты: свежие выше. */
const articles = [...ARTICLES].sort((a, b) => (a.date < b.date ? 1 : -1));

const ld = [
  ...organizationLd().filter((o) => o['@type'] !== 'FAQPage' && o['@type'] !== 'Service'),
  blogLd(articles),
];

const title = (slug: string) => ALL_SERVICES.find((s) => s.slug === slug)?.title ?? '';

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Base
  meta={{
    title: 'Блог: SEO, GEO, реклама и соцсети | AI-Traffic PRO',
    description:
      'Разбираем практические вопросы маркетинга: выбор канала, окупаемость рекламы, ответы нейросетей, контент для соцсетей и порядок в заявках без иллюзий.',
    path,
  }}
  ld={ld}
>
  <!-- Хлебные крошки -->
  <nav aria-label="Хлебные крошки" class="bg-white border-b border-stone-200">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop py-4">
      <ol class="flex flex-wrap items-center gap-2 font-mono-index text-mono-index text-stone-700">
        <li>
          <a href="/" class="hover:text-terracotta-600 transition-colors">
            Главная
          </a>
        </li>
        <li aria-hidden="true" class="text-stone-400">
          /
        </li>
        <li class="text-stone-900" aria-current="page">
          Блог
        </li>
      </ol>
    </div>
  </nav>

  <!-- Заголовок -->
  <header class="w-full border-b border-stone-200 bg-white">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop py-16 md:py-24">
      <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-3">
        [БЛОГ]
      </span>
      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-light text-stone-900 tracking-tight leading-[1.06] max-w-3xl mb-6">
        Разбираем маркетинг по частям
      </h1>
      <p class="font-body-lg text-body-lg text-stone-700 leading-relaxed max-w-2xl">
        Практические статьи без «10 секретов успеха»: как выбирать каналы, считать окупаемость,
        готовить сайт к ответам нейросетей и не терять заявки. Каждая статья связана с услугой, о
        которой в ней речь.
      </p>
    </div>
  </header>

  <!-- Список статей -->
  <section class="w-full bg-stone-50 py-16 md:py-24">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {articles.map((a) => (
          <a
            href={`/blog/${a.slug}/`}
            class="group rounded-2xl border border-stone-200 bg-white p-8 flex flex-col hover:border-primary-container transition-colors"
          >
            <div class="flex items-center gap-3 mb-4">
              <span class="font-mono-label text-mono-label uppercase tracking-wider text-terracotta-600">
                {a.tag}
              </span>
              <span class="font-mono-index text-mono-index text-stone-400">{a.readingTime} мин</span>
            </div>

            <h2 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-3 group-hover:text-terracotta-600 transition-colors">
              {a.title}
            </h2>

            <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed mb-5">
              {a.seoDescription}
            </p>

            <div class="mt-auto pt-5 border-t border-stone-200 flex items-center justify-between gap-3">
              <span class="font-mono-index text-mono-index text-stone-400">{title(a.service)}</span>
              <span class="font-mono-index text-mono-index text-stone-400">{fmt(a.date)}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="w-full border-t border-stone-200 bg-stone-100 py-14 md:py-24">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
      <div class="rounded-2xl border border-stone-200 bg-white p-8 md:p-14 text-center">
        <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight mb-4">
          Не нашли свою задачу?
        </h2>
        <p class="font-body-md text-body-md text-stone-700 mb-8 max-w-2xl mx-auto">
          Опишите ситуацию — вернёмся с планом: что проверить первым, какие каналы имеют смысл и
          какие сроки реалистичны.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/#contact"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-2xl bg-stone-900 text-on-primary font-body-sm text-body-sm font-semibold hover:bg-stone-900 transition-colors"
          >
            Оставить заявку
          </a>
          <a
            href={SITE.bot.link}
            target="_blank"
            rel="noopener"
            class="inline-flex items-center justify-center px-7 py-3.5 rounded-2xl border border-stone-200 bg-stone-50 text-stone-900 font-body-sm text-body-sm font-medium hover:border-primary-container hover:text-terracotta-600 transition-colors"
          >
            Написать в Telegram
          </a>
        </div>
      </div>
    </div>
  </section>
</Base>
