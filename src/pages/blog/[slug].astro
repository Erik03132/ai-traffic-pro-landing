---
/**
 * Статья блога. Один шаблон на все статьи.
 *
 * Содержимое — из `src/data/blog/<slug>.ts`. В разметке нет ни одного текста
 * статьи: заголовки, абзацы, списки и FAQ приходят из данных.
 *
 * Перелинковка (задача 2.7): каждая статья ссылается на свою услугу,
 * на список статей и на соседние материалы — до любой страницы ≤ 3 клика.
 */
import type { GetStaticPaths } from 'astro';

import Base from '../../layouts/Base.astro';
import Faq from '../../components/Faq.astro';

import { ARTICLES } from '../../data/blog';
import { ALL_SERVICES } from '../../data/site';
import { articleLd, faqLd, organizationLd } from '../../lib/seo';

export const getStaticPaths = (() =>
  ARTICLES.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }))) satisfies GetStaticPaths;

const { article } = Astro.props;

const service = ALL_SERVICES.find((s) => s.slug === article.service);

/** Соседние статьи: сначала из той же услуги, потом остальные. */
const related = [
  ...ARTICLES.filter((a) => a.slug !== article.slug && a.service === article.service),
  ...ARTICLES.filter((a) => a.slug !== article.slug && a.service !== article.service),
].slice(0, 3);

const path = `/blog/${article.slug}/`;

const ld = [
  ...organizationLd().filter((o) => o['@type'] !== 'FAQPage' && o['@type'] !== 'Service'),
  ...articleLd(article),
  faqLd(article.faq),
];

const dateLabel = new Date(article.date).toLocaleDateString('ru-RU', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Base
  meta={{
    title: article.seoTitle,
    description: article.seoDescription,
    path,
    type: 'article',
    image: article.image,
  }}
  ld={ld}
  localFaq={true}
  localContact={false}
>
  <!-- Хлебные крошки -->
  <nav aria-label="Хлебные крошки" class="bg-white border-b border-stone-200">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop py-4">
      <ol class="flex flex-wrap items-center gap-2 font-mono-index text-mono-index text-stone-700">
        <li>
          <a href="/" class="hover:text-terracotta-600 transition-colors">
            Главная
          </a>
        </li>
        <li aria-hidden="true" class="text-stone-400">
          /
        </li>
        <li>
          <a href="/blog/" class="hover:text-terracotta-600 transition-colors">
            Блог
          </a>
        </li>
        <li aria-hidden="true" class="text-stone-400">
          /
        </li>
        <li class="text-stone-900" aria-current="page">
          {article.title}
        </li>
      </ol>
    </div>
  </nav>

  <!-- Заголовок статьи -->
  <header class="w-full border-b border-stone-200 bg-white">
    <div class="max-w-3xl mx-auto px-margin md:px-margin-desktop py-8 md:py-20">
      <div class="flex flex-wrap items-center gap-3 mb-6">
        <span class="inline-flex items-center px-3 py-1 rounded-full border border-stone-200 bg-stone-100 font-mono-label text-mono-label uppercase tracking-wider text-terracotta-600">
          {article.tag}
        </span>
        <span class="font-mono-index text-mono-index text-stone-400">
          {dateLabel} · {article.readingTime} мин чтения
        </span>
      </div>

      <h1 class="text-5xl sm:text-6xl lg:text-7xl font-light text-stone-900 tracking-tight leading-[1.06] mb-6">
        {article.title}
      </h1>

      <p class="font-body-lg text-body-lg text-stone-700 leading-relaxed">
        {article.lead}
      </p>

      {article.author && (
        <div class="mt-6 flex items-center gap-3 border-t border-stone-200 pt-4">
          <span class="material-symbols-outlined text-stone-400 text-xl">person</span>
          <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
            <span class="text-stone-900 font-semibold">{article.author.name}</span>
            <span class="text-stone-500"> — {article.author.role}</span>
          </p>
        </div>
      )}

      {
        /* Обложку в шапке не показываем: она дублирует H1 и мешает чтению.
           Картинка остаётся в og:image — для превью ссылки в соцсетях. */
      }
    </div>
  </header>

  <!-- Тело статьи -->
  <article class="w-full bg-stone-50 py-8 md:py-20">
    <div class="max-w-3xl mx-auto px-margin md:px-margin-desktop">
      {article.sections.map((section, i) => (
        <section class={i === 0 ? '' : 'mt-8 sm:mt-12'}>
          <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight mb-5">
            {section.title}
          </h2>

          {section.paragraphs?.map((p) => (
            <p class="font-body-md text-body-md text-stone-700 leading-relaxed mb-5" set:html={p} />
          ))}

          {section.table && (
            <div class="my-6 -mx-margin md:mx-0 overflow-x-auto">
              <table class="w-full min-w-[34rem] border-collapse text-left">
                <thead>
                  <tr class="border-b-2 border-stone-300">
                    {section.table.head.map((h) => (
                      <th class="py-3 pr-4 font-mono-label text-mono-label uppercase tracking-widest text-stone-500 font-semibold align-bottom">
                        {h}
                      </th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {section.table.rows.map((row) => (
                    <tr class="border-b border-stone-200 align-top">
                      {row.map((cell, ci) => (
                        <td
                          class:list={[
                            'py-3 pr-4 font-body-sm text-body-sm leading-relaxed',
                            ci === 0 ? 'text-stone-900 font-semibold' : 'text-stone-700',
                          ]}
                        >
                          {cell}
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {section.list && (
            <ul class="space-y-3 my-6">
              {section.list.map((item) => (
                <li class="flex items-start gap-3">
                  <span class="material-symbols-outlined text-terracotta-600 text-xl mt-0.5 shrink-0">
                    check_circle
                  </span>
                  <span class="font-body-md text-body-md text-stone-900 leading-relaxed">
                    {item}
                  </span>
                </li>
              ))}
            </ul>
          )}

          {section.steps && (
            <ol class="space-y-4 my-6">
              {section.steps.map((step, n) => (
                <li class="flex items-start gap-4">
                  <span class="w-8 h-8 shrink-0 rounded-2xl bg-stone-100 border border-stone-200 flex items-center justify-center font-mono-index text-mono-index font-semibold text-terracotta-600">
                    {n + 1}
                  </span>
                  <span class="font-body-md text-body-md text-stone-900 leading-relaxed">
                    {step}
                  </span>
                </li>
              ))}
            </ol>
          )}

          {section.sub?.map((s) => (
            <div class="mt-8">
              <h3 class="text-xl sm:text-2xl font-light text-stone-900 tracking-tight leading-tight mb-3">
                {s.title}
              </h3>
              {s.paragraphs?.map((p) => (
                <p class="font-body-md text-body-md text-stone-700 leading-relaxed mb-5" set:html={p} />
              ))}
              {s.list && (
                <ul class="space-y-2 my-5">
                  {s.list.map((item) => (
                    <li class="flex items-start gap-3">
                      <span class="material-symbols-outlined text-terracotta-600 text-lg mt-1 shrink-0">
                        check_circle
                      </span>
                      <span class="font-body-md text-body-md text-stone-900 leading-relaxed" set:html={item} />
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </section>
      ))}

      <!-- Ссылка на услугу: статья → её кластер -->
      {service && (
        <aside class="mt-8 sm:mt-14 rounded-2xl border border-stone-200 bg-stone-100 p-4 sm:p-8">
          <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
            [УСЛУГА ПО ТЕМЕ]
          </span>
          <h2 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-2">
            {service.title}
          </h2>
          <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed mb-5">
            {service.card}
          </p>
          <a
            href={`/services/${service.slug}/`}
            class="inline-flex items-center gap-2 px-6 py-3 rounded-2xl bg-stone-900 text-on-primary font-body-sm text-body-sm font-semibold hover:bg-stone-900 transition-colors"
          >
            Подробнее об услуге
            <span class="material-symbols-outlined text-base">arrow_forward</span>
          </a>
        </aside>
      )}

      <!-- Первоисточники: на них опираются утверждения и цифры в тексте -->
      {article.sources?.length && (
        <section class="mt-8 sm:mt-14 border-t border-stone-200 pt-6">
          <span class="font-mono-label text-mono-label uppercase text-stone-500 tracking-widest font-semibold block mb-3">
            [ИСТОЧНИКИ]
          </span>
          <ol class="space-y-2">
            {article.sources.map((s, n) => (
              <li class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                <span class="text-stone-500 mr-2">{n + 1}.</span>
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer nofollow"
                  class="underline decoration-stone-300 underline-offset-2 hover:decoration-terracotta-600"
                >
                  {s.label}
                </a>
              </li>
            ))}
          </ol>
        </section>
      )}
    </div>
  </article>

  <!-- FAQ статьи -->
  <Faq items={article.faq} eyebrow="[ВОПРОСЫ ПО ТЕМЕ]" title="Коротко о главном" id="faq" />

  <!-- Другие статьи -->
  <section class="w-full border-t border-stone-200 bg-white py-8 md:py-24">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
      <div class="flex items-end justify-between gap-4 sm:gap-6 mb-6 sm:mb-10">
        <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
          Читать дальше
        </h2>
        <a
          href="/blog/"
          class="font-body-sm text-body-sm text-terracotta-600 hover:text-stone-900 transition-colors whitespace-nowrap"
        >
          Все статьи →
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-6">
        {related.map((a) => (
          <a
            href={`/blog/${a.slug}/`}
            class="group rounded-2xl border border-stone-200 bg-stone-50 p-4 sm:p-6 flex flex-col hover:border-primary-container transition-colors"
          >
            <span class="font-mono-label text-mono-label uppercase tracking-wider text-stone-400 mb-3">
              {a.tag}
            </span>
            <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-3 group-hover:text-terracotta-600 transition-colors">
              {a.title}
            </h3>
            <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed mt-auto">
              {a.seoDescription}
            </p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
