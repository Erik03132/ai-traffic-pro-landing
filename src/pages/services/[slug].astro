          <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
            [03.5 / КАНАЛЫ РЕКЛАМЫ]
          </span>
          <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
            Где запускаем&nbsp;<span class="accent-italic">рекламу</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
          {service.channels.map((c) => (
            <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4 sm:p-8">
              <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-2">
                {c.name}
              </h3>
              <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                {c.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ФОРМАТЫ И ИНСТРУМЕНТЫ (только для advertising) -->
  {service.slug === 'advertising' && service.adFormats && (
    <section class="w-full border-b border-stone-200 bg-stone-50 py-8 md:py-28">
      <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-6 lg:gap-16">
          <div class="lg:col-span-5">
            <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
              [03.6 / ФОРМАТЫ И ИНСТРУМЕНТЫ]
            </span>
            <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
              Какие форматы&nbsp;<span class="accent-italic">используем</span>
            </h2>
            <p class="font-body-md text-body-md text-stone-700 leading-relaxed mt-3">
              Не просто «объявления» — полный цикл: структура кампаний, креативы под формат, сквозная аналитика, еженедельная CPL-оптимизация.
            </p>
          </div>

          <div class="lg:col-span-7">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
              {service.adFormats.map((f) => (
                <div class="rounded-2xl border border-stone-200 bg-white p-4 sm:p-8">
                  <span class="material-symbols-outlined text-terracotta-600 text-2xl mb-4">
                    {f.icon}
                  </span>
                  <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-3">
                    {f.title}
                  </h3>
                  <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                    {f.text}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- КОНТЕНТ-ПЛАН И БЕСПЛАТНЫЕ ПОСТЫ (только для advertising) -->
  {service.slug === 'advertising' && service.contentPlan && (
    <section class="w-full border-b border-stone-200 bg-white py-8 md:py-28">
      <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
        <div class="mb-14">
          <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
            [03.7 / КОНТЕНТ-ПЛАН И БЕСПЛАТНЫЕ ПОСТЫ]
          </span>
          <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
            <span class="accent-italic">Органика</span> в соцсетях: подписчики без стоимости за клик
          </h2>
        </div>

        {service.contentPlan.map((cp) => (
          <div class="space-y-12">
            <div class="prose prose-stone max-w-none">
              <h3 class="text-2xl sm:text-3xl font-light text-stone-900 tracking-tight mb-4">
                {cp.title}
              </h3>
              <p class="font-body-lg text-body-lg text-stone-700 leading-relaxed mb-6 sm:mb-10">
                {cp.text}
              </p>
            </div>

            <!-- Площадки и форматы -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
              {cp.platforms.map((p) => (
                <div class="rounded-2xl border border-stone-200 bg-stone-50 p-4 sm:p-8">
                  <h4 class="text-lg sm:text-xl font-medium text-stone-900 mb-3">
                    {p.name}
                  </h4>
                  <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed mb-4">
                    {p.desc}
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {p.formats.map((f) => (
                      <span class="px-3 py-1.5 rounded-full border border-stone-200 bg-white font-body-sm text-body-sm text-stone-700">
                        {f}
                      </span>
                    ))}
                  </div>
                </div>
              ))}
            </div>

            <!-- Процесс -->
            <div class="border-t border-stone-200 pt-10">
              <h4 class="text-lg sm:text-xl font-medium text-stone-900 mb-6">
                Как работаем
              </h4>
              <ol class="space-y-4">
                {cp.process.map((step, i) => (
                  <li class="flex gap-4">
                    <span class="font-mono-label text-mono-label text-terracotta-600 shrink-0 w-8 text-center">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <span class="font-body-md text-body-md text-stone-700 leading-relaxed">
                      {step}
                    </span>
                  </li>
                ))}
              </ol>
            </div>

            <!-- Метрики -->
            <div class="border-t border-stone-200 pt-10">
              <h4 class="text-lg sm:text-xl font-medium text-stone-900 mb-6">
                За чем следим
              </h4>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                {cp.metrics.map((m, i) => (
                  <li class="flex items-start gap-3">
                    <span class="material-symbols-outlined text-sage-600 text-xl mt-0.5 shrink-0">
                      check_circle
                    </span>
                    <span class="font-body-md text-body-md text-stone-700 leading-relaxed">
                      {m}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <!--
    СРАВНЕНИЕ И ИСТОЧНИКИ — главный GEO-блок страницы услуги.

    Зачем отдельным блоком: нейросети и расширенные сниппеты цитируют таблицу
    и проверяемые утверждения, а не абзацы про «системный подход». Прогон
    `tools/geo_lint.py` 22.11.2026 показал: у страниц услуг было 0/14 за
    таблицу и 0/10 за источники — при том, что блог набирал 96/100.
  -->
  {
    (service.comparison || service.facts || service.sources) && (
      <section class="w-full border-b border-stone-200 bg-white py-8 md:py-28">
        <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
          {service.comparison && (
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-6 lg:gap-16">
              <div class="lg:col-span-4">
                <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
                  [03.8 / СРАВНЕНИЕ]
                </span>
                <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
                  {service.comparison.title}
                </h2>
                {service.comparison.intro && (
                  <p class="font-body-md text-body-md text-stone-700 leading-relaxed mt-3">
                    {service.comparison.intro}
                  </p>
                )}
              </div>

              <div class="lg:col-span-8">
                <div class="-mx-margin md:mx-0 overflow-x-auto">
                  <table class="w-full min-w-[36rem] border-collapse text-left">
                    <thead>
                      <tr class="border-b-2 border-stone-300">
                        {service.comparison.head.map((h) => (
                          <th class="py-3 pr-4 font-mono-label text-mono-label uppercase tracking-widest text-stone-500 font-semibold align-bottom">
                            {h}
                          </th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {service.comparison.rows.map((row) => (
                        <tr class="border-b border-stone-200 align-top">
                          {row.map((cell, ci) => (
                            <td
                              class:list={[
                                'py-3 pr-4 font-body-sm text-body-sm leading-relaxed',
                                ci === 0 ? 'text-stone-900 font-semibold' : 'text-stone-700',
                              ]}
                            >
                              {cell}
                            </td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                <p class="font-body-sm text-body-sm text-stone-500 leading-relaxed mt-4">
                  Цифры в таблице — рабочие ориентиры по опыту, а не оферта. Точные сроки и бюджет
                  фиксируем после вводной: они зависят от вашей отрасли, конкуренции и объёма.
                </p>
              </div>
            </div>
          )}

          {service.facts && service.facts.length > 0 && (
            <div class="mt-14 border-t border-stone-200 pt-8">
              <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
                [03.85 / ПРОВЕРЯЕМЫЕ ФАКТЫ]
              </span>
              <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
                Что можно проверить по ссылке
              </h2>
              <p class="font-body-md text-body-md text-stone-700 leading-relaxed mt-3">
                Утверждения ниже привязаны к странице или первоисточнику и дате проверки.
                Это не обещание результата: сроки и бюджеты уточняются после вводной.
              </p>
              <ul class="mt-6 space-y-4">
                {service.facts.map((f) => (
                  <li class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                    <span class="text-stone-900">{f.claim}</span>
                    {' — '}
                    <a
                      href={f.url}
                      target={f.url.startsWith('http') ? '_blank' : undefined}
                      rel={f.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                      class="text-stone-900 underline decoration-stone-300 underline-offset-2 hover:text-terracotta-600 hover:decoration-terracotta-600 transition-colors"
                    >
                      {f.source}
                    </a>
                    <span class="text-stone-500"> (проверено {f.checkedAt})</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {service.sources && (
            <div class="mt-14 border-t border-stone-200 pt-8">
              <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-4">
                [03.9 / ИСТОЧНИКИ]
              </span>
              <ul class="grid grid-cols-1 md:grid-cols-2 gap-3 sm:gap-4">
                {service.sources.map((s) => (
                  <li class="font-body-sm text-body-sm leading-relaxed">
                    <a
                      href={s.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-stone-900 underline decoration-stone-300 underline-offset-2 hover:text-terracotta-600 hover:decoration-terracotta-600 transition-colors"
                    >
                      {s.title}
                    </a>
                    {s.note && <span class="text-stone-600"> — {s.note}</span>}
                  </li>
                ))}
              </ul>
              <p class="font-body-sm text-body-sm text-stone-500 leading-relaxed mt-4">
                Ссылки ведут на официальную документацию платформ: проверяем утверждения по
                первоисточникам, а не по пересказам.
              </p>
            </div>
          )}

          <!--
            Автор — сигнал E-E-A-T: у материала есть человек, который отвечает
            за написанное. Модели и оценщики качества считают страницу без
            автора анонимной, а анонимное не цитируют.
          -->
          <div class="mt-10 flex items-center gap-4 rounded-2xl border border-stone-200 bg-stone-50 p-4 sm:p-6">
            <img
              src={IGOR_VASIN.photo}
              srcset={`${IGOR_VASIN.photo} 1x, ${IGOR_VASIN.photo2x} 2x`}
              width="56"
              height="56"
              loading="lazy"
              alt={`${IGOR_VASIN.name} — ${IGOR_VASIN.role}`}
              class="w-14 h-14 rounded-full object-cover shrink-0"
            />
            <div>
              <a
                href="/author/"
                class="font-body-sm text-body-sm font-semibold text-stone-900 hover:text-terracotta-600 transition-colors"
              >
                {IGOR_VASIN.name}
              </a>
              <span class="font-body-sm text-body-sm text-stone-600"> — {IGOR_VASIN.role}</span>
              <p class="font-body-sm text-body-sm text-stone-600 leading-relaxed mt-1">
                Отвечает за содержание направления «{service.title}»: метод, сроки и отчётность.
              </p>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Инструмент: аудит страницы. Только на SEO/GEO — там он уместен как
       следующий шаг разговора, а не рекламная вставка на каждой услуге. -->
  {
    (service.slug === 'seo' || service.slug === 'geo') && (
      <section class="w-full border-t border-stone-200 bg-stone-900 text-white py-8 md:py-20" id="audit-cta">
        <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-center">
            <div class="lg:col-span-8">
              <span class="font-mono-label text-mono-label uppercase text-terracotta-400 tracking-widest font-semibold block mb-3">
                [ПРОВЕРКА]
              </span>
              <h2 class="text-3xl sm:text-4xl font-light tracking-tight leading-tight mb-4">
                Сначала посмотрите, что не так —{' '}
                <span class="accent-italic text-stone-300">потом решайте про подрядчика</span>
              </h2>
              <p class="text-stone-300 text-base leading-relaxed max-w-2xl">
                Бесплатный AI-аудит покажет балл вашей страницы из 100 и список правок: где нет
                прямого ответа, цифр, таблицы сравнения и разметки. Около 10 секунд, без
                регистрации. Часто после отчёта становится понятно, что часть работы можно
                сделать своими силами — так и честнее.
              </p>
            </div>
            <div class="lg:col-span-4 lg:text-right">
              <a
                href="/audit/"
                class="inline-flex items-center justify-center h-12 px-6 rounded-2xl bg-white text-stone-900 text-sm font-medium hover:bg-stone-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-terracotta-400 focus-visible:ring-offset-2 focus-visible:ring-offset-stone-900"
              >
                Проверить страницу
              </a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <!-- Статьи блога по теме (перелинковка услуга ↔ блог, задача 2.7 ROADMAP) -->
  {
    relatedArticles.length > 0 && (
      <section class="w-full border-t border-stone-200 bg-white py-8 md:py-28">
        <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
          <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-3">
            [04 / МАТЕРИАЛЫ]
          </span>
          <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight mb-6">
            Разборы по теме — <span class="accent-italic">без воды и «успешных кейсов»</span>
          </h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-6">
            {relatedArticles.map((a) => (
              <a
                href={`/blog/${a.slug}/`}
                class="group flex flex-col justify-between gap-4 p-5 sm:p-6 rounded-2xl border border-stone-200 bg-stone-50 hover:border-stone-300 hover:bg-white transition-colors"
              >
                <div>
                  <div class="font-mono text-[11px] uppercase tracking-wider text-stone-500 mb-2">
                    {a.tag} · {a.readingTime} мин
                  </div>
                  <h3 class="text-lg font-light text-stone-900 leading-snug mb-3 group-hover:text-terracotta-600 transition-colors">
                    {a.title}
                  </h3>
                  <p class="text-sm text-stone-600 leading-relaxed">{a.lead.slice(0, 150)}…</p>
                </div>
                <span class="font-mono text-[11px] uppercase tracking-wider text-terracotta-600">
                  Читать →
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- FAQ услуги -->
  <Faq
    items={service.faq}
    eyebrow="[05 / ВОПРОСЫ И ОТВЕТЫ]"
    title={`Вопросы и ответы по услуге «${service.title}»`}
    id="faq"
  />

  <!-- Форма заявки -->
  <section class="w-full border-t border-stone-200 bg-stone-100 py-8 md:py-28" id="lead">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
      <div class="border border-stone-200 bg-white rounded-2xl p-4 sm:p-8 md:p-14">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
          <div class="lg:col-span-5">
            <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-3">
              [06 / ЗАЯВКА]
            </span>
            <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight mb-6">
              Оставьте заявку — <span class="accent-italic">свяжемся в течение рабочего дня</span>
            </h2>
            <p class="font-body-md text-body-md text-stone-700 leading-relaxed mb-8">
              Расскажите о задаче — вернёмся с конкретным планом и оценкой. Без обязательств.
            </p>

            <div class="p-4 sm:p-6 rounded-2xl border border-stone-200 bg-stone-100 space-y-4">
              <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-sage-600 text-xl mt-0.5">
                  check_circle
                </span>
                <span class="font-body-sm text-body-sm text-stone-900">
                  Отвечаем в течение рабочего дня
                </span>
              </div>
              <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-sage-600 text-xl mt-0.5">
                  check_circle
                </span>
                <span class="font-body-sm text-body-sm text-stone-900">
                  План первоначальных гипотез на встрече
                </span>
              </div>
              <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-sage-600 text-xl mt-0.5">
                  check_circle
                </span>
                <span class="font-body-sm text-body-sm text-stone-900">
                  Без навязывания лишних пакетов
                </span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-7">
            <LeadForm id="service-form" service={service.slug} />
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
