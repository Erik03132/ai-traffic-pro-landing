---
/**
 * Страница услуги. Один шаблон на все 7 страниц (6 основных + маркетплейс).
 *
 * Всё содержимое — из `src/data/site.ts`: тексты, мета, FAQ. Здесь нет ни одного
 * захардкоженного заголовка. На странице есть рабочая форма (LeadForm).
 */
import type { GetStaticPaths } from 'astro';

import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import Faq from '../../components/Faq.astro';

import { ALL_SERVICES, SERVICES, type Service } from '../../data/site';
import { ARTICLES } from '../../data/blog';
import { organizationLd, serviceLd, faqLd, serviceBreadcrumbLd, howToLd } from '../../lib/seo';

export const getStaticPaths = (() =>
  ALL_SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const path = `/services/${service.slug}/`;
const isMain = service.inMain;

// JSON-LD: организация + сайт (общие) + услуга + FAQ + breadcrumbs + HowTo.
const ld = [
  ...organizationLd().filter((o) => o['@type'] !== 'Service' && o['@type'] !== 'FAQPage'),
  serviceLd(service.slug),
  faqLd(service.faq),
  serviceBreadcrumbLd(service.slug, service.title),
  howToLd(
    `Как получить ${service.title.toLowerCase()}`,
    service.subtitle,
    service.steps.map((s) => ({ title: s.title, text: s.text })),
  ),
].filter(Boolean);

const otherServices = SERVICES.filter((s) => s.slug !== service.slug);
---

<Base
  meta={{
    title: service.seoTitle,
    description: service.seoDescription,
    path,
    type: 'website',
  }}
  ld={ld as Record<string, unknown>[]}
  localFaq
  localContact
>
  <!-- Хлебные крошки -->
  <nav aria-label="Хлебные крошки" class="bg-white border-b border-stone-200">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop py-4">
      <ol class="flex flex-wrap items-center gap-2 font-mono-index text-mono-index text-stone-700">
        <li>
          <a href="/" class="hover:text-terracotta-600 transition-colors">
            Главная
          </a>
        </li>
        <li aria-hidden="true" class="text-stone-400">
          /
        </li>
        <li>
          <a href="/#services" class="hover:text-terracotta-600 transition-colors">
            Услуги
          </a>
        </li>
        <li aria-hidden="true" class="text-stone-400">
          /
        </li>
        <li class="text-stone-900" aria-current="page">
          {service.title}
        </li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="w-full border-b border-stone-200 bg-white">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-8">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-11 h-11 rounded-2xl bg-white border border-stone-200 flex items-center justify-center font-mono-index text-mono-index font-semibold text-terracotta-600">
              {Number(service.num) || '—'}
            </span>
            <span class="px-2.5 py-0.5 rounded border border-[#BFDBFE] bg-[#EFF6FF] text-terracotta-600 font-mono-label text-mono-label font-semibold tracking-wider uppercase flex items-center gap-1.5">
              <span class="material-symbols-outlined text-base align-middle">{service.icon}</span>
              {service.badge}
            </span>
          </div>

          <h1 class="text-5xl sm:text-6xl lg:text-7xl font-light text-stone-900 tracking-tight leading-[1.06] mb-5">
            {service.h1}
          </h1>
          <p class="font-body-lg text-body-lg text-stone-700 max-w-3xl leading-relaxed">
            {service.subtitle}
          </p>

          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <a
              href="#lead"
              class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-2xl bg-stone-900 text-on-primary font-body-sm text-body-sm font-semibold hover:bg-stone-800 transition-all duration-150 text-center active:scale-[0.99]"
            >
              Оставить заявку
              <span class="material-symbols-outlined text-base align-middle">arrow_outward</span>
            </a>
            <a
              href="#what-included"
              class="inline-flex items-center justify-center px-7 py-3.5 rounded-2xl border border-stone-200 bg-white text-stone-900 font-body-sm text-body-sm font-medium hover:border-stone-300 hover:bg-stone-50 transition-colors text-center"
            >
              Что входит
            </a>
            <a
              href="#lead"
              class="inline-flex items-center justify-center px-7 py-3.5 rounded-2xl border border-stone-200 bg-white text-stone-900 font-body-sm text-body-sm font-medium hover:border-terracotta-500 hover:text-terracotta-600 transition-colors text-center"
            >
              Получить КП
            </a>
          </div>
        </div>

        <div class="lg:col-span-4">
          <div class="rounded-2xl border border-stone-200 bg-stone-100 p-6 space-y-5">
            <div>
              <span class="font-mono-label text-mono-label uppercase text-stone-400 block mb-1">
                Метрика
              </span>
              <span class="font-body-md text-body-md text-stone-900">{service.metric}</span>
            </div>
            <div class="border-t border-stone-200 pt-4">
              <span class="font-mono-label text-mono-label uppercase text-stone-400 block mb-1">
                Кому подходит
              </span>
              <span class="font-body-md text-body-md text-stone-900">{service.forWhom}</span>
            </div>
            <div class="border-t border-stone-200 pt-4">
              <span class="font-mono-label text-mono-label uppercase text-stone-400 block mb-3">
                Что получите
              </span>
              <ul class="space-y-3">
                {service.outcomes.slice(0, 3).map((o) => (
                  <li class="flex items-start gap-2.5">
                    <span class="material-symbols-outlined text-terracotta-600 text-base mt-0.5 shrink-0">
                      check_circle
                    </span>
                    <span class="font-body-sm text-body-sm text-stone-900 leading-relaxed">{o}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="border-t border-stone-200 pt-4">
              <span class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                Стоимость:{' '}
                <span class="font-semibold text-stone-900">по запросу</span>
                — считаем после короткой вводной.
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- С какой проблемой приходят -->
  <section class="w-full border-b border-stone-200 bg-stone-50 py-20 md:py-28">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
      <div class="mb-14">
        <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
          [01 / С ЧЕМ ПРИХОДЯТ]
        </span>
        <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
          С какой проблемой приходят
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {service.problem.map((p) => (
          <div class="rounded-2xl border border-stone-200 bg-white p-8 flex flex-col">
            <span class="material-symbols-outlined text-terracotta-600 text-2xl mb-4">
              report_problem
            </span>
            <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-3">
              {p.title}
            </h3>
            <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
              {p.text}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Кому подходит -->
  <section class="w-full border-b border-stone-200 bg-stone-50 py-20 md:py-28">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
      <div class="mb-14">
        <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
          [02 / КОМУ ПОДХОДИТ]
        </span>
        <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
          Кому эта услуга решает задачу
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {service.audience.map((a) => (
          <div class="rounded-2xl border border-stone-200 bg-white p-8">
            <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-2">
              {a.title}
            </h3>
            <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
              {a.text}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Как это работает -->
  <section class="w-full border-b border-stone-200 bg-white py-20 md:py-28">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
      <div class="mb-14">
        <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
          [03 / КАК ЭТО РАБОТАЕТ]
        </span>
        <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
          Четыре шага до результата
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        {service.steps.map((s) => (
          <div class="flex flex-col">
            <div class="flex items-center gap-3 mb-6">
              <span class="w-14 h-14 rounded-2xl bg-white border border-stone-200 flex items-center justify-center font-mono-index text-mono-index font-semibold text-terracotta-600">
                {service.steps.indexOf(s) + 1}
              </span>
              <span class="hidden lg:block w-3 h-px bg-stone-900" />
            </div>
            <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-2">
              {s.title}
            </h3>
            <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
              {s.text}
            </p>
            <span class="mt-4 inline-flex items-center gap-2 self-start px-3 py-1 rounded-full border border-stone-200 bg-white font-mono-label text-mono-label uppercase tracking-wider text-stone-700">
              <span class="material-symbols-outlined text-base text-terracotta-600">
                schedule
              </span>
              {s.period}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Как решаем -->
  <section class="w-full border-b border-stone-200 bg-white py-20 md:py-28">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
      <div class="mb-14">
        <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
          [04 / КАК РЕШАЕМ]
        </span>
        <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
          Как решаем задачу
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {service.solution.map((s, i) => (
          <div class="rounded-2xl border border-stone-200 bg-white p-8">
            <div class="flex items-center gap-3 mb-4">
              <span class="w-10 h-10 rounded-2xl bg-stone-100 border border-stone-200 flex items-center justify-center font-mono-index text-mono-index font-semibold text-terracotta-600">
                {i + 1}
              </span>
              <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight">{s.title}</h3>
            </div>
            <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
              {s.text}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Кейсы -->
  <section class="w-full border-b border-stone-200 bg-stone-50 py-20 md:py-28">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
      <div class="mb-14">
        <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
          [04.5 / КЕЙСЫ]
        </span>
        <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
          Реальные результаты, а не обещания
        </h2>
        <p class="font-body-md text-body-md text-stone-700 max-w-2xl mt-3">
          Имена клиентов не публикуем по условиям договора, но цифры — реальные.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {service.cases && service.cases.map((c) => (
          <div class="rounded-2xl border border-stone-200 bg-white p-8 flex flex-col">
            <div class="text-4xl sm:text-5xl font-light text-terracotta-600 tracking-tight leading-none mb-4">
              {c.metric}
            </div>
            <div class="space-y-3 mb-6">
              <div>
                <span class="font-mono-label text-mono-label uppercase text-stone-400 tracking-wider block mb-1">
                  Было
                </span>
                <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">{c.before}</p>
              </div>
              <div>
                <span class="font-mono-label text-mono-label uppercase text-stone-400 tracking-wider block mb-1">
                  Стало
                </span>
                <p class="font-body-sm text-body-sm text-stone-900 leading-relaxed">{c.after}</p>
              </div>
            </div>
            <span class="mt-auto inline-flex items-center gap-2 self-start px-3 py-1 rounded-full border border-stone-200 bg-stone-50 font-mono-label text-mono-label uppercase tracking-wider text-stone-500">
              <span class="material-symbols-outlined text-base text-terracotta-600">schedule</span>
              {c.period}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Отзывы -->
  <section class="w-full border-b border-stone-200 bg-white py-20 md:py-28">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
      <div class="mb-14">
        <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
          [04.6 / ОТЗЫВЫ]
        </span>
        <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
          Что говорят те, кто уже работает с нами
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {service.reviews && service.reviews.map((r) => (
          <div class="rounded-2xl border border-stone-200 bg-stone-50 p-8 flex flex-col">
            <span class="material-symbols-outlined text-terracotta-600 text-2xl mb-4">
              format_quote
            </span>
            <p class="font-body-md text-body-md text-stone-800 leading-relaxed mb-6 flex-1">
              «{r.text}»
            </p>
            <span class="font-mono-label text-mono-label uppercase text-stone-400 tracking-wider">
              {r.role}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GEO-слой -->
  <section class="w-full border-b border-stone-200 bg-stone-50 py-20 md:py-28">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        <div class="lg:col-span-5">
          <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
            [04.7 / GEO-СЛОЙ]
          </span>
          <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
            Как сайт попадает в ответы нейросетей
          </h2>
          <p class="font-body-md text-body-md text-stone-700 leading-relaxed mt-3">
            GEO и AEO — это отдельная работа от обычного SEO. Нейросети не читают сайт целиком: они выбирают, какие страницы и факты взять для ответа. Готовим именно те страницы, которые будут цитироваться.
          </p>
        </div>

        <div class="lg:col-span-7">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="rounded-2xl border border-stone-200 bg-white p-8">
              <span class="material-symbols-outlined text-terracotta-600 text-2xl mb-4">
                search
              </span>
              <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-3">
                Прямые ответы
              </h3>
              <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                На каждой ключевой странице — чёткий ответ на типичный вопрос пользователя. Нейросеть берёт именно такие фрагменты, а не общие описания.
              </p>
            </div>
            <div class="rounded-2xl border border-stone-200 bg-white p-8">
              <span class="material-symbols-outlined text-terracotta-600 text-2xl mb-4">
                database
              </span>
              <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-3">
                Структурированные данные
              </h3>
              <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                JSON-LD и микроразметка, которые однозначно объясняют поисковым системам и нейросетям: что это за услуга, кто её предоставляет, на какую задачу отвечает.
              </p>
            </div>
            <div class="rounded-2xl border border-stone-200 bg-white p-8">
              <span class="material-symbols-outlined text-terracotta-600 text-2xl mb-4">
                hub
              </span>
              <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-3">
                Факты, а не формулировки
              </h3>
              <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                На страницах — конкретные цифры, условия, сроки и ограничения. Нейросети доверяют текстам, где можно проверить каждое утверждение.
              </p>
            </div>
            <div class="rounded-2xl border border-stone-200 bg-white p-8">
              <span class="material-symbols-outlined text-terracotta-600 text-2xl mb-4">
                verified_user
              </span>
              <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-3">
                Источники и цитируемость
              </h3>
              <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                Работаем с тем, что цитируют другие: профили, отраслевые источники, упоминания в блоге. Без этого бренд остаётся вне разговора, даже если сайт технически идеален.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Внутренние ссылки -->
  <section class="w-full border-b border-stone-200 bg-white py-20 md:py-28">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        <div class="lg:col-span-5">
          <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
            [04.8 / ПОХОЖИЕ]
          </span>
          <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
            Что ещё может быть нужно
          </h2>
          <p class="font-body-md text-body-md text-stone-700 leading-relaxed mt-3">
            Остальные направления: каждый решает свою задачу, но работают в связке.
          </p>
        </div>

        <div class="lg:col-span-7">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {otherServices.slice(0, 4).map((s) => (
              <a
                href={`/services/${s.slug}/`}
                class="group flex items-center gap-4 p-5 rounded-2xl border border-stone-200 bg-stone-50 hover:bg-white hover:border-terracotta-300 transition-colors"
              >
                <span class="w-10 h-10 rounded-xl bg-white border border-stone-200 flex items-center justify-center shrink-0 group-hover:border-terracotta-300 transition-colors">
                  <span class="material-symbols-outlined text-terracotta-600 text-xl">{s.icon}</span>
                </span>
                <div class="flex-1 min-w-0">
                  <div class="font-body-sm text-body-sm font-semibold text-stone-900 group-hover:text-terracotta-600 transition-colors truncate">
                    {s.title}
                  </div>
                  <div class="font-mono-label text-mono-label uppercase text-stone-400 tracking-wider">
                    {s.badge}
                  </div>
                </div>
                <span class="material-symbols-outlined text-stone-400 group-hover:text-terracotta-600 transition-colors shrink-0">
                  arrow_forward
                </span>
              </a>
            ))}
          </div>

          <div class="mt-6">
            <span class="font-mono-label text-mono-label uppercase text-stone-400 tracking-wider block mb-3">
              Статьи из блога по этой теме
            </span>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {ARTICLES.filter((a) => a.service === service.slug).slice(0, 2).map((a) => (
                <a
                  href={`/blog/${a.slug}/`}
                  class="group flex items-start gap-3 p-4 rounded-2xl border border-stone-200 bg-stone-50 hover:bg-white hover:border-terracotta-300 transition-colors"
                >
                  <span class="material-symbols-outlined text-terracotta-600 text-lg mt-0.5 shrink-0">
                    article
                  </span>
                  <div class="flex-1 min-w-0">
                    <div class="font-body-sm text-body-sm font-semibold text-stone-900 group-hover:text-terracotta-600 transition-colors leading-snug">
                      {a.title}
                    </div>
                    <div class="font-mono-label text-mono-label uppercase text-stone-400 tracking-wider mt-1">
                      {a.readingTime} мин чтения
                    </div>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Что входит + что получите -->
  <section class="w-full border-b border-stone-200 bg-stone-50 py-20 md:py-28" id="what-included">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
        <div class="lg:col-span-7">
          <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
            [05 / ЧТО ВХОДИТ]
          </span>
          <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight mb-8">
            Что входит в работу
          </h2>

          <ul class="border-t border-stone-200">
            {service.includes.map((item) => (
              <li class="flex items-start gap-3 py-5 border-b border-stone-200">
                <span class="material-symbols-outlined text-terracotta-600 text-xl mt-0.5 shrink-0">
                  check_circle
                </span>
                <span class="font-body-md text-body-md text-stone-900">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="lg:col-span-5">
          <div class="rounded-2xl border border-stone-200 bg-stone-100 p-8 lg:sticky lg:top-28">
            <span class="font-mono-label text-mono-label uppercase text-stone-400 tracking-widest block mb-6">
              [ЧТО ВЫ ПОЛУЧИТЕ]
            </span>
            <ul class="space-y-5">
              {service.outcomes.map((o) => (
                <li class="flex items-start gap-3">
                  <span class="material-symbols-outlined text-terracotta-600 text-xl mt-0.5 shrink-0">
                    arrow_forward
                  </span>
                  <span class="font-body-sm text-body-sm text-stone-900 leading-relaxed">{o}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ услуги -->
  <Faq
    items={service.faq}
    eyebrow="[06 / ВОПРОСЫ И ОТВЕТЫ]"
    title={`Вопросы и ответы по услуге «${service.title}»`}
    id="faq"
  />

  <!-- Форма заявки -->
  <section class="w-full border-t border-stone-200 bg-stone-100 py-20 md:py-28" id="lead">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
      <div class="border border-stone-200 bg-white rounded-2xl p-8 md:p-14">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
          <div class="lg:col-span-5">
            <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-3">
              [07 / ЗАЯВКА]
            </span>
            <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight mb-6">
              Оставьте заявку — свяжемся в течение рабочего дня
            </h2>
            <p class="font-body-md text-body-md text-stone-700 leading-relaxed mb-8">
              Расскажите о задаче — вернёмся с конкретным планом и оценкой. Без обязательств.
            </p>

            <div class="p-6 rounded-2xl border border-stone-200 bg-stone-100 space-y-4">
              <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-terracotta-600 text-xl mt-0.5">
                  check_circle
                </span>
                <span class="font-body-sm text-body-sm text-stone-900">
                  Отвечаем в течение рабочего дня
                </span>
              </div>
              <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-terracotta-600 text-xl mt-0.5">
                  check_circle
                </span>
                <span class="font-body-sm text-body-sm text-stone-900">
                  План первоначальных гипотез на встрече
                </span>
              </div>
              <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-terracotta-600 text-xl mt-0.5">
                  check_circle
                </span>
                <span class="font-body-sm text-body-sm text-stone-900">
                  Без навязывания лишних пакетов
                </span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-7">
            <LeadForm id="service-form" service={service.slug} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Другие услуги -->
  <section class="w-full bg-stone-50 py-20 md:py-28">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
      <div class="mb-12">
        <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
          [08 / ДРУГИЕ НАПРАВЛЕНИЯ]
        </span>
        <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
          Что ещё мы делаем
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {otherServices.map((s) => (
          <a
            href={`/services/${s.slug}/`}
            class="group flex flex-col justify-between p-8 rounded-2xl border border-stone-200 bg-white hover:border-primary-container transition-all duration-200"
          >
            <div>
              <div class="flex items-center justify-between mb-6">
                <span class="font-mono-index text-mono-index text-stone-400 group-hover:text-terracotta-600 transition-colors">
                  {Number(s.num) || '—'}
                </span>
                <span class="material-symbols-outlined text-stone-400 group-hover:text-terracotta-600 text-2xl transition-colors">
                  {s.icon}
                </span>
              </div>
              <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-3 group-hover:text-terracotta-600 transition-colors">
                {s.title}
              </h3>
              <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                {s.card}
              </p>
            </div>
            <div class="pt-4 mt-6 border-t border-stone-200 flex items-center font-mono-index text-mono-index text-stone-900 group-hover:text-terracotta-600 font-medium">
              <span>Подробнее об услуге</span>
              <span class="inline-block transform group-hover:translate-x-1.5 transition-transform duration-150 ml-1">
                →
              </span>
            </div>
          </a>
        ))}
      </div>

      {!isMain && (
        <p class="mt-10 font-body-sm text-body-sm text-stone-700">
          Нужно что-то из соседних направлений?{' '}
          <a class="link-underline text-terracotta-600 hover:underline" href="/#services">
            Посмотрите все шесть услуг
          </a>
          .
        </p>
      )}
    </div>
  </section>
</Base>
