---
/**
 * Страница услуги. Один шаблон на все 7 страниц (6 основных + маркетплейс).
 *
 * Всё содержимое — из `src/data/site.ts`: тексты, мета, FAQ. Здесь нет ни одного
 * захардкоженного заголовка. На странице есть рабочая форма (LeadForm).
 */
import type { GetStaticPaths } from 'astro';

import Base from '../../layouts/Base.astro';
import LeadForm from '../../components/LeadForm.astro';
import Faq from '../../components/Faq.astro';

import { ALL_SERVICES, SERVICES, type Service } from '../../data/site';
import { ARTICLES } from '../../data/blog';
import { organizationLd, serviceLd, faqLd, serviceBreadcrumbLd, howToLd } from '../../lib/seo';

export const getStaticPaths = (() =>
  ALL_SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }))) satisfies GetStaticPaths;

interface Props {
  service: Service;
}

const { service } = Astro.props;
const path = `/services/${service.slug}/`;
const isMain = service.inMain;

// JSON-LD: организация + сайт (общие) + услуга + FAQ + breadcrumbs + HowTo.
const ld = [
  ...organizationLd().filter((o) => o['@type'] !== 'Service' && o['@type'] !== 'FAQPage'),
  serviceLd(service.slug),
  faqLd(service.faq),
  serviceBreadcrumbLd(service.slug, service.title),
  howToLd(
    `Как получить ${service.title.toLowerCase()}`,
    service.subtitle,
    service.steps.map((s) => ({ title: s.title, text: s.text })),
  ),
].filter(Boolean);

const otherServices = SERVICES.filter((s) => s.slug !== service.slug);
---

<Base
  meta={{
    title: service.seoTitle,
    description: service.seoDescription,
    path,
    type: 'website',
  }}
  ld={ld as Record<string, unknown>[]}
  localFaq
  localContact
>
  <!-- Хлебные крошки -->
  <nav aria-label="Хлебные крошки" class="bg-white border-b border-stone-200">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop py-4">
      <ol class="flex flex-wrap items-center gap-2 font-mono-index text-mono-index text-stone-700">
        <li>
          <a href="/" class="hover:text-terracotta-600 transition-colors">
            Главная
          </a>
        </li>
        <li aria-hidden="true" class="text-stone-400">
          /
        </li>
        <li>
          <a href="/#services" class="hover:text-terracotta-600 transition-colors">
            Услуги
          </a>
        </li>
        <li aria-hidden="true" class="text-stone-400">
          /
        </li>
        <li class="text-stone-900" aria-current="page">
          {service.title}
        </li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="w-full border-b border-stone-200 bg-white">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop py-16 md:py-24">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        <div class="lg:col-span-8">
          <div class="flex items-center gap-3 mb-6">
            <span class="w-11 h-11 rounded-2xl bg-white border border-stone-200 flex items-center justify-center font-mono-index text-mono-index font-semibold text-terracotta-600">
              {Number(service.num) || '—'}
            </span>
            <span class="px-2.5 py-0.5 rounded border border-[#BFDBFE] bg-[#EFF6FF] text-terracotta-600 font-mono-label text-mono-label font-semibold tracking-wider uppercase flex items-center gap-1.5">
              <span class="material-symbols-outlined text-base align-middle">{service.icon}</span>
              {service.badge}
            </span>
          </div>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-light text-stone-900 tracking-tight leading-[1.06] mb-5">
            {service.h1.split('|').map((line, i) => (
              <span key={i} class="block" style={{ display: 'block' }}>
                {i === 0 ? (
                  <span>{line}</span>
                ) : (
                  <span class="accent-italic">{line}</span>
                )}
              </span>
            ))}
          </h1>
          <p class="font-body-lg text-body-lg text-stone-700 max-w-3xl leading-relaxed">
            {service.subtitle}
          </p>

          <div class="mt-8">
            <a
              href="#lead"
              class="inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-2xl bg-stone-900 text-on-primary font-body-sm text-body-sm font-semibold hover:bg-stone-800 transition-all duration-150 text-center active:scale-[0.99]"
            >
              Оставить заявку
              <span class="material-symbols-outlined text-base align-middle">arrow_outward</span>
            </a>
          </div>
        </div>

        <div class="lg:col-span-4">
          <div class="rounded-2xl border border-stone-200 bg-stone-100 p-6 space-y-5">
            <div>
              <span class="font-mono-label text-mono-label uppercase text-stone-400 block mb-1">
                Метрика
              </span>
              <span class="font-body-md text-body-md text-stone-900">{service.metric}</span>
            </div>
            <div class="border-t border-sage-200 pt-4">
              <span class="font-mono-label text-mono-label uppercase text-stone-400 block mb-1">
                Кому подходит
              </span>
              <span class="font-body-md text-body-md text-stone-900">{service.forWhom}</span>
            </div>
            <div class="border-t border-sage-200 pt-4">
              <span class="font-mono-label text-mono-label uppercase text-stone-400 block mb-3">
                Что получите
              </span>
              <ul class="space-y-3">
                {service.outcomes.slice(0, 3).map((o) => (
                  <li class="flex items-start gap-2.5">
                    <span class="material-symbols-outlined text-sage-600 text-base mt-0.5 shrink-0">
                      check_circle
                    </span>
                    <span class="font-body-sm text-body-sm text-stone-900 leading-relaxed">{o}</span>
                  </li>
                ))}
              </ul>
            </div>
            <div class="border-t border-sage-200 pt-4">
              <span class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                Стоимость:{' '}
                <span class="font-semibold text-stone-900">по запросу</span>
                — считаем после короткой вводной.
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- С какой проблемой приходят -->
  <section class="w-full border-b border-stone-200 bg-stone-50 py-20 md:py-28">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
      <div class="mb-14">
        <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
          [01 / С ЧЕМ ПРИХОДЯТ]
        </span>
        <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
          С какой проблеме&nbsp;<span class="accent-italic">приходят</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {service.problem.map((p) => (
          <div class="rounded-2xl border border-stone-200 bg-white p-8 flex flex-col">
            <span class="material-symbols-outlined text-terracotta-600 text-2xl mb-4">
              report_problem
            </span>
            <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-3">
              {p.title}
            </h3>
            <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
              {p.text}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Как это работает -->
  <section class="w-full border-b border-stone-200 bg-white py-20 md:py-28">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
      <div class="mb-14">
        <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
          [03 / КАК ЭТО РАБОТАЕТ]
        </span>
        <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
          Четыре шага&nbsp;<span class="accent-italic">до результата</span>
        </h2>
      </div>

      <div class="relative">
        <!-- Вертикальная линия прогресса — только между первым и последним шагом -->
        <div class="hidden lg:block absolute left-[70px] top-[7px] bottom-[7px] w-px bg-stone-200" />
        
        <div class="space-y-10 lg:space-y-16">
          {service.steps.map((s, i) => (
            <div class="relative flex gap-6 group">
              <!-- Номер шага -->
              <div class="flex flex-col items-center lg:w-[140px] shrink-0 relative z-10">
                <div class="w-14 h-14 rounded-full bg-white border-4 border-stone-200 flex items-center justify-center font-mono-index text-mono-index font-semibold text-terracotta-600 group-hover:border-terracotta-600 transition-colors duration-300 relative z-10">
                  {i + 1}
                </div>
              </div>
              
              <!-- Контент шага -->
              <div class="flex-1 min-w-0 pt-2 lg:pt-0">
                <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-3">
                  {s.title}
                </h3>
                <p class="font-body-md text-body-md text-stone-700 leading-relaxed mb-6">
                  {s.text}
                </p>
                <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-sage-200 bg-sage-50 font-mono-label text-mono-label uppercase tracking-wider text-sage-700">
                  <span class="material-symbols-outlined text-base text-sage-600">
                    schedule
                  </span>
                  {s.period}
                </span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Как решаем -->
  <section class="w-full border-b border-stone-200 bg-white py-20 md:py-28">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
      <div class="mb-14">
        <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
          [04 / КАК РЕШАЕМ]
        </span>
        <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
          Наш подход к&nbsp;<span class="accent-italic">решению задачи</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {service.solution.map((s, i) => (
          <div class="rounded-2xl border border-stone-200 bg-white p-8">
            <div class="flex items-start gap-4 mb-4">
              <div class="w-14 h-14 rounded-full bg-white border-4 border-stone-200 flex items-center justify-center font-mono-index text-mono-index font-semibold text-terracotta-600 shrink-0">
                {i + 1}
              </div>
              <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight pt-1">
                {s.title}
              </h3>
            </div>
            <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
              {s.text}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- GEO-слой (только для SEO) -->
  {service.slug === 'seo' && (
    <section class="w-full border-b border-stone-200 bg-stone-50 py-20 md:py-28">
      <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
          <div class="lg:col-span-5">
            <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
              [04.7 / GEO-СЛОЙ]
            </span>
            <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
              Как сайт&nbsp;<span class="accent-italic">попадает в ответы нейросетей</span>
            </h2>
            <p class="font-body-md text-body-md text-stone-700 leading-relaxed mt-3">
              GEO и AEO — это отдельная работа от обычного SEO. Нейросети не читают сайт целиком: они выбирают, какие страницы и факты взять для ответа. Готовим именно те страницы, которые будут цитироваться.
            </p>
          </div>

          <div class="lg:col-span-7">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div class="rounded-2xl border border-stone-200 bg-white p-8">
                <span class="material-symbols-outlined text-terracotta-600 text-2xl mb-4">
                  search
                </span>
                <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-3">
                  Прямые ответы
                </h3>
                <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                  На каждой ключевой странице — чёткий ответ на типичный вопрос пользователя. Нейросеть берёт именно такие фрагменты, а не общие описания.
                </p>
              </div>
              <div class="rounded-2xl border border-stone-200 bg-white p-8">
                <span class="material-symbols-outlined text-terracotta-600 text-2xl mb-4">
                  database
                </span>
                <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-3">
                  Структурированные данные
                </h3>
                <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                  JSON-LD и микроразметка, которые однозначно объясняют поисковым системам и нейросетям: что это за услуга, кто её предоставляет, на какую задачу отвечает.
                </p>
              </div>
              <div class="rounded-2xl border border-stone-200 bg-white p-8">
                <span class="material-symbols-outlined text-terracotta-600 text-2xl mb-4">
                  hub
                </span>
                <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-3">
                  Факты, а не формулировки
                </h3>
                <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                  На страницах — конкретные цифры, условия, сроки и ограничения. Нейросети доверяют текстам, где можно проверить каждое утверждение.
                </p>
              </div>
              <div class="rounded-2xl border border-stone-200 bg-white p-8">
                <span class="material-symbols-outlined text-terracotta-600 text-2xl mb-4">
                  verified_user
                </span>
                <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-3">
                  Источники и цитируемость
                </h3>
                <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                  Работаем с тем, что цитируют другие: профили, отраслевые источники, упоминания в блоге. Без этого бренд остаётся вне разговора, даже если сайт технически идеален.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ИНТЕГРАЦИОННЫЙ СЛОЙ (только для CRM) -->
  {service.slug === 'crm' && (
    <section class="w-full border-b border-stone-200 bg-stone-50 py-20 md:py-28">
      <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
          <div class="lg:col-span-5">
            <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
              [04.5 / ИНТЕГРАЦИОННЫЙ СЛОЙ]
            </span>
            <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
              Как сайт, бот, реклама и телефония&nbsp;<span class="accent-italic">работают в одной системе</span>
            </h2>
            <p class="font-body-md text-body-md text-stone-700 leading-relaxed mt-3">
              CRM — это центр, куда сходятся все каналы привлечения клиентов. Готовим сайт, Telegram-бота, рекламные кабинеты и телефонию так, чтобы заявка попадала в систему сразу — без ручного переноса.
            </p>
          </div>

          <div class="lg:col-span-7">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              <div class="rounded-2xl border border-stone-200 bg-white p-8">
                <span class="material-symbols-outlined text-terracotta-600 text-2xl mb-4">
                  web
                </span>
                <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-3">
                  Сайт и лендинги
                </h3>
                <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                  Формы, чат-виджеты, попапы → сразу в CRM с меткой источника и UTM. Без ручного переноса.
                </p>
              </div>
              <div class="rounded-2xl border border-stone-200 bg-white p-8">
                <span class="material-symbols-outlined text-terracotta-600 text-2xl mb-4">
                  smart_toy
                </span>
                <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-3">
                  Telegram-бот (FSM-сценарии)
                </h3>
                <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                  Квалификация, сбор недостающих данных, передача готового лида в CRM. Клиент в привычном мессенджере.
                </p>
              </div>
              <div class="rounded-2xl border border-stone-200 bg-white p-8">
                <span class="material-symbols-outlined text-terracotta-600 text-2xl mb-4">
                  campaign
                </span>
                <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-3">
                  Рекламные кабинеты
                </h3>
                <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                  Яндекс Директ, VK Реклама, Telegram Ads → стоимость заявки по каналам в отчёте воронки автоматически.
                </p>
              </div>
              <div class="rounded-2xl border border-stone-200 bg-white p-8">
                <span class="material-symbols-outlined text-terracotta-600 text-2xl mb-4">
                  call
                </span>
                <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-3">
                  Телефония и почта
                </h3>
                <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                  Звонки и письма — в истории сделки. Запись разговора, транскрибация, привязка к контакту.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ТЕХНОЛОГИЧЕСКИЙ СТЕК (только для CRM) -->
  {service.slug === 'crm' && (
    <section class="w-full border-b border-stone-200 bg-white py-20 md:py-28">
      <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
        <div class="mb-14">
          <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
            [04.6 / ТЕХНОЛОГИЧЕСКИЙ СТЕК]
          </span>
          <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
            С какой CRM&nbsp;<span class="accent-italic">работаем</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="rounded-2xl border border-stone-200 bg-stone-50 p-8">
            <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-2">
              amoCRM
            </h3>
            <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
              Лидер для малого бизнеса, гибкие воронки, маркетплейс интеграций
            </p>
          </div>
          <div class="rounded-2xl border border-stone-200 bg-stone-50 p-8">
            <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-2">
              Битрикс24
            </h3>
            <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
              Если нужны и CRM, и задачи, и телефония, и сайт в одной экосистеме
            </p>
          </div>
          <div class="rounded-2xl border border-stone-200 bg-stone-50 p-8">
            <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-2">
              HubSpot
            </h3>
            <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
              Для B2B с длинным циклом, маркетинг-автоматизация и англоязычный интерфейс
            </p>
          </div>
          <div class="rounded-2xl border border-stone-200 bg-stone-50 p-8">
            <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-2">
              Другие / Кастом
            </h3>
            <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
              Pipedrive, Salesforce, самописные — подключим через API/вебхуки
            </p>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- ПЛОЩАДКИ (только для SMM) -->
  {service.slug === 'smm' && service.platforms && (
    <section class="w-full border-b border-stone-200 bg-white py-20 md:py-28">
      <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
        <div class="mb-14">
          <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
            [04.5 / ПЛОЩАДКИ]
          </span>
          <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
            Где ведём&nbsp;<span class="accent-italic">соцсети</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {service.platforms.map((p) => (
            <div class="rounded-2xl border border-stone-200 bg-stone-50 p-8">
              <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-2">
                {p.name}
              </h3>
              <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                {p.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ФОРМАТЫ КОНТЕНТА (только для SMM) -->
  {service.slug === 'smm' && service.contentFormats && (
    <section class="w-full border-b border-stone-200 bg-stone-50 py-20 md:py-28">
      <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
          <div class="lg:col-span-5">
            <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
              [04.6 / ФОРМАТЫ КОНТЕНТА]
            </span>
            <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
              Какие форматы&nbsp;<span class="accent-italic">делаем</span>
            </h2>
            <p class="font-body-md text-body-md text-stone-700 leading-relaxed mt-3">
              Не просто «посты» — производственный конвейер: сценарии, съёмка, монтаж, дизайн-пакет, шаблоны. Под каждую площадку и задачу.
            </p>
          </div>

          <div class="lg:col-span-7">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {service.contentFormats.map((f) => (
                <div class="rounded-2xl border border-stone-200 bg-white p-8">
                  <span class="material-symbols-outlined text-terracotta-600 text-2xl mb-4">
                    {f.icon}
                  </span>
                  <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-3">
                    {f.title}
                  </h3>
                  <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                    {f.text}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- КАНАЛЫ РЕКЛАМЫ (только для advertising) -->
  {service.slug === 'advertising' && service.channels && (
    <section class="w-full border-b border-stone-200 bg-white py-20 md:py-28">
      <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
        <div class="mb-14">
          <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
            [04.5 / КАНАЛЫ РЕКЛАМЫ]
          </span>
          <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
            Где запускаем&nbsp;<span class="accent-italic">рекламу</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {service.channels.map((c) => (
            <div class="rounded-2xl border border-stone-200 bg-stone-50 p-8">
              <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-2">
                {c.name}
              </h3>
              <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                {c.desc}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ФОРМАТЫ И ИНСТРУМЕНТЫ (только для advertising) -->
  {service.slug === 'advertising' && service.adFormats && (
    <section class="w-full border-b border-stone-200 bg-stone-50 py-20 md:py-28">
      <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16">
          <div class="lg:col-span-5">
            <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-2">
              [04.6 / ФОРМАТЫ И ИНСТРУМЕНТЫ]
            </span>
            <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight">
              Какие форматы&nbsp;<span class="accent-italic">используем</span>
            </h2>
            <p class="font-body-md text-body-md text-stone-700 leading-relaxed mt-3">
              Не просто «объявления» — полный цикл: структура кампаний, креативы под формат, сквозная аналитика, еженедельная CPL-оптимизация.
            </p>
          </div>

          <div class="lg:col-span-7">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {service.adFormats.map((f) => (
                <div class="rounded-2xl border border-stone-200 bg-white p-8">
                  <span class="material-symbols-outlined text-terracotta-600 text-2xl mb-4">
                    {f.icon}
                  </span>
                  <h3 class="text-xl sm:text-2xl lg:text-3xl font-light text-stone-900 tracking-tight mb-3">
                    {f.title}
                  </h3>
                  <p class="font-body-sm text-body-sm text-stone-700 leading-relaxed">
                    {f.text}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- FAQ услуги -->
  <Faq
    items={service.faq}
    eyebrow="[06 / ВОПРОСЫ И ОТВЕТЫ]"
    title={`Вопросы и ответы по услуге «${service.title}»`}
    id="faq"
  />

  <!-- Форма заявки -->
  <section class="w-full border-t border-stone-200 bg-stone-100 py-20 md:py-28" id="lead">
    <div class="max-w-[1280px] mx-auto px-margin md:px-margin-desktop">
      <div class="border border-stone-200 bg-white rounded-2xl p-8 md:p-14">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
          <div class="lg:col-span-5">
            <span class="font-mono-label text-mono-label uppercase text-terracotta-600 tracking-widest font-semibold block mb-3">
              [07 / ЗАЯВКА]
            </span>
            <h2 class="text-3xl sm:text-4xl font-light text-stone-900 tracking-tight leading-tight mb-6">
              Оставьте заявку — <span class="accent-italic">свяжемся в течение рабочего дня</span>
            </h2>
            <p class="font-body-md text-body-md text-stone-700 leading-relaxed mb-8">
              Расскажите о задаче — вернёмся с конкретным планом и оценкой. Без обязательств.
            </p>

            <div class="p-6 rounded-2xl border border-stone-200 bg-stone-100 space-y-4">
              <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-sage-600 text-xl mt-0.5">
                  check_circle
                </span>
                <span class="font-body-sm text-body-sm text-stone-900">
                  Отвечаем в течение рабочего дня
                </span>
              </div>
              <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-sage-600 text-xl mt-0.5">
                  check_circle
                </span>
                <span class="font-body-sm text-body-sm text-stone-900">
                  План первоначальных гипотез на встрече
                </span>
              </div>
              <div class="flex items-start gap-3">
                <span class="material-symbols-outlined text-sage-600 text-xl mt-0.5">
                  check_circle
                </span>
                <span class="font-body-sm text-body-sm text-stone-900">
                  Без навязывания лишних пакетов
                </span>
              </div>
            </div>
          </div>

          <div class="lg:col-span-7">
            <LeadForm id="service-form" service={service.slug} />
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>
